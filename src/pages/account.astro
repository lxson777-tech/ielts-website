---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AccountOverview from '../components/AccountOverview';
import CurrentLevel from '../components/CurrentLevel';
import TypeAnalytics from '../components/TypeAnalytics';
import ScoreHistory from '../components/ScoreHistory';
import WritingHistory from '../components/WritingHistory';
import SpeakingHistory from '../components/SpeakingHistory';
import SavedItems from '../components/SavedItems';
import { withBase } from '../lib/url';
---

<BaseLayout
  title="My Account · IELTS Portal"
  description="Track your progress across Reading, Writing and Speaking in one place: lessons completed, band history, and your course progress."
>
  <div class="platform-hub mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <header class="mb-10 flex flex-wrap items-end justify-between gap-4 border-b border-border pb-8">
      <div>
        <p class="font-display text-xs font-extrabold uppercase tracking-[0.12em] text-brand">My account</p>
        <h1 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Account &amp; progress</h1>
        <p class="mt-3 max-w-2xl text-ink-muted">Every skill and every attempt in one place, so you can see what is improving and what to practise next.</p>
      </div>
      <a href={withBase('/report')} class="shrink-0 rounded-button border border-border px-4 py-2 font-display text-sm font-semibold text-ink-muted transition-colors hover:border-brand hover:text-brand">
        Progress report →
      </a>
    </header>

    <div class="mb-6">
      <CurrentLevel client:load />
    </div>

    <AccountOverview client:load />

    <section id="saved" class="mt-16 scroll-mt-20">
      <SectionHeading eyebrow="Saved" title="Saved lessons & questions" subtitle="Everything you have bookmarked while studying, plus your lesson notes." />
      <SavedItems client:load />
    </section>

    <section id="reading" class="mt-16 scroll-mt-20">
      <SectionHeading eyebrow="Reading" title="Your weak spots" subtitle="Accuracy by question type across every attempt. Drill the red ones first." />
      <TypeAnalytics client:load />
      <div class="mt-8">
        <SectionHeading eyebrow="Reading" title="Score history" />
        <ScoreHistory client:load />
      </div>
    </section>

    <section id="listening" class="mt-16 scroll-mt-20">
      <SectionHeading eyebrow="Listening" title="Your weak spots" subtitle="Accuracy by question type across every listening test." />
      <TypeAnalytics client:load skill="listening" />
      <div class="mt-8">
        <SectionHeading eyebrow="Listening" title="Score history" />
        <ScoreHistory client:load skill="listening" showReset={false} />
      </div>
    </section>

    <section id="writing" class="mt-16 scroll-mt-20">
      <SectionHeading eyebrow="Writing" title="Score history" subtitle="Every essay you've submitted to the AI examiner." />
      <WritingHistory client:load />
    </section>

    <section id="speaking" class="mt-16 scroll-mt-20">
      <SectionHeading eyebrow="Speaking" title="Score history" subtitle="Every part you've practiced with the AI examiner." />
      <SpeakingHistory client:load />
    </section>
  </div>
</BaseLayout>

<style is:global>
  @import '../styles/platform-pages.css';
</style>
