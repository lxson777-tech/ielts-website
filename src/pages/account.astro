---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AccountOverview from '../components/AccountOverview';
import TypeAnalytics from '../components/TypeAnalytics';
import ScoreHistory from '../components/ScoreHistory';
import WritingHistory from '../components/WritingHistory';
import SpeakingHistory from '../components/SpeakingHistory';
import SavedItems from '../components/SavedItems';
import AccountSettings from '../components/AccountSettings';
import { withBase } from '../lib/url';
---

<BaseLayout
  title="My Account · IELTS Portal"
  description="Track your progress across Reading, Writing and Speaking in one place: lessons completed, band history, and your course progress."
>
  <div class="account-page platform-hub mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <header class="mb-10 flex flex-wrap items-end justify-between gap-4 border-b border-border pb-8">
      <div>
        <h1 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl" data-i18n>Your account</h1>
        <p class="mt-3 max-w-2xl text-ink-muted" data-i18n>Your saved work and account details. Open your progress report for the bigger picture.</p>
      </div>
      <a href={withBase('/report')} class="shrink-0 rounded-button border border-border px-4 py-2 font-display text-sm font-semibold text-ink-muted transition-colors hover:border-brand hover:text-brand" data-i18n>
        Progress report
      </a>
    </header>

    {/* Your details, email, password and devices. Signed-in only; renders
        nothing otherwise. */}
    <AccountSettings client:load />

    <AccountOverview client:load />

    <nav class="account-section-links" aria-label="Account sections">
      <a href="#saved" data-i18n>Saved lessons & questions</a>
      <a href="#reading" data-i18n>Reading</a>
      <a href="#listening" data-i18n>Listening</a>
      <a href="#writing" data-i18n>Writing</a>
      <a href="#speaking" data-i18n>Speaking</a>
    </nav>

    <details id="saved" class="support-disclosure account-history">
      <summary data-i18n>Saved lessons & questions</summary>
      <div class="account-history-body">
      <SectionHeading eyebrow="Saved" title="Saved lessons & questions" subtitle="Everything you have bookmarked while studying, plus your lesson notes." />
      <SavedItems client:load />
      </div>
    </details>

    <details id="reading" class="support-disclosure account-history">
      <summary data-i18n>Reading history</summary>
      <div class="account-history-body">
      <SectionHeading eyebrow="Reading" title="Your weak spots" subtitle="Accuracy by question type across every attempt. Drill the red ones first." />
      <TypeAnalytics client:load />
      <div class="mt-8">
        <SectionHeading eyebrow="Reading" title="Score history" />
        <ScoreHistory client:load />
      </div>
      </div>
    </details>

    <details id="listening" class="support-disclosure account-history">
      <summary data-i18n>Listening history</summary>
      <div class="account-history-body">
      <SectionHeading eyebrow="Listening" title="Your weak spots" subtitle="Accuracy by question type across every listening test." />
      <TypeAnalytics client:load skill="listening" />
      <div class="mt-8">
        <SectionHeading eyebrow="Listening" title="Score history" />
        <ScoreHistory client:load skill="listening" showReset={false} />
      </div>
      </div>
    </details>

    <details id="writing" class="support-disclosure account-history">
      <summary data-i18n>Writing history</summary>
      <div class="account-history-body">
      <SectionHeading eyebrow="Writing" title="Score history" subtitle="Every essay you've submitted to the AI examiner." />
      <WritingHistory client:load />
      </div>
    </details>

    <details id="speaking" class="support-disclosure account-history">
      <summary data-i18n>Speaking history</summary>
      <div class="account-history-body">
      <SectionHeading eyebrow="Speaking" title="Score history" subtitle="Every part you've practiced with the AI examiner." />
      <SpeakingHistory client:load />
      </div>
    </details>
  </div>
  <script>
    function openAccountSection() {
      const target = document.getElementById(location.hash.slice(1));
      if (target instanceof HTMLDetailsElement) target.open = true;
    }
    openAccountSection();
    document.addEventListener('astro:page-load', openAccountSection);
    window.addEventListener('hashchange', openAccountSection);
  </script>
</BaseLayout>

<style is:global>
  @import '../styles/platform-pages.css';
  @import '../styles/auth.css';
</style>
