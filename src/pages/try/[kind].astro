---
/* /try/essay and /try/speaking: where a free account uses its one free
   essay check and its one free recorded Speaking check (free AI tries,
   10 October 2026). They exist ONLY in the gated commercial build: the open
   site (today's live site) never had these pages, and publishing them there
   would change it. A dynamic route so the open build simply generates no
   page here (the same way /speaking/recorded does).

   The page is open to any signed-in account ("free" gate); the component
   (TasterTry) decides what that account sees. The questions are public text,
   never the paid bank, so nothing paid is in this page's markup. */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TasterTry from '../../components/access/TasterTry';
import { isTrialBuild } from '../../lib/trial/mode';

export const getStaticPaths: GetStaticPaths = () =>
  isTrialBuild()
    ? [
        { params: { kind: 'essay' }, props: { kindName: 'essay' } },
        { params: { kind: 'speaking' }, props: { kindName: 'speaking' } },
      ]
    : [];

const { kindName } = Astro.props as { kindName: 'essay' | 'speaking' };
const essay = kindName === 'essay';
---
<BaseLayout
  title={essay ? 'Free essay check · IELTS Portal' : 'Free Speaking check · IELTS Portal'}
  trialGate={{ kind: 'free', title: essay ? 'Free essay check' : 'Free Speaking check' }}
  noindex
>
  <div class={`${essay ? 'skill-writing' : 'skill-speaking'} mx-auto max-w-4xl px-4 py-12 sm:px-6`}>
    {essay ? <p class="text-xs font-bold uppercase tracking-wider text-[var(--skill,#0E9F6E)]" data-i18n>Writing</p> : <p class="text-xs font-bold uppercase tracking-wider text-[var(--skill,#0E9F6E)]" data-i18n>Speaking</p>}
    {essay ? <h1 class="mt-2 text-3xl font-extrabold" data-i18n>Your free essay check</h1> : <h1 class="mt-2 text-3xl font-extrabold" data-i18n>Your free Speaking check</h1>}
    <div class="mt-6">
      <TasterTry client:load kind={kindName} />
    </div>
  </div>
</BaseLayout>
