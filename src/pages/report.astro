---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProgressReport from '../components/ProgressReport';
import { withBase } from '../lib/url';
---

<BaseLayout
  title="Progress Report · IELTS Portal"
  description="A printable summary of your study plan, lessons completed, test bands and streak, ready to save as a PDF."
>
  <div class="report-page platform-hub mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <header class="report-print-hide mb-10 border-b border-border pb-8">
      <p class="font-display text-xs font-extrabold uppercase tracking-[0.12em] text-brand" data-i18n>Progress report</p>
      <h1 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl" data-i18n>Your progress, one page.</h1>
      {/* The sentence has a link in the middle, so it is marked in three
          pieces rather than one: data-i18n can only replace an element whose
          content is plain text (src/lib/i18n/dom.ts), and wrapping the whole
          paragraph would delete the link. Same shape reading-task1.astro
          already uses for "Your score history lives on the [practice tests
          page]". The English words and their order are untouched, so an
          English reader sees byte-identical text; each piece is a whole
          clause, and the Russian for the three is written to read as one
          sentence in that order. */}
      <p class="mt-3 max-w-2xl text-ink-muted">
        <span data-i18n>Everything from your</span> <a href={withBase('/account')} class="font-semibold text-brand hover:underline" data-i18n>account page</a> <span data-i18n>laid out for printing or saving as a PDF.</span>
      </p>
    </header>

    <ProgressReport client:load />
  </div>
</BaseLayout>

<style is:global>
  @import '../styles/platform-pages.css';
</style>
