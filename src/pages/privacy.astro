---
/* /privacy: what the site collects, why, what it keeps and which services
   handle it (Builder E, 29 September 2026).

   Every statement was checked against the code on that date, not written
   from general expectations:
   - profile fields and their rules: src/lib/auth/profile.ts,
     supabase/migrations/2026-09-24-profiles.sql; seen by the owner in
     /admin (2026-09-24-admin.sql);
   - saved study: src/lib/progress.ts (essays kept with their report;
     Speaking keeps bands only, no recording is stored anywhere by our code);
   - Mr EZ: conversations in Supabase, cleared by the student in
     MrEzMemory on /plan-settings; the Worker sends the model the student's
     message and facts counted from their own record (workers/mr-ez);
   - grading: essay text and Speaking audio go to OpenAI through the
     grade-essay and grade-speaking Workers on Cloudflare (their READMEs);
   - live examiner: audio goes browser to OpenAI directly; the Worker only
     brokers the session and keeps a timing row (live_examiner_sessions);
   - trial: trial_accounts (start, end, the goal questions) and trial_usage.
     The trial is retired (Alex, 1 October 2026): nothing starts a new one,
     but the rows already written are kept (nothing is deleted), so the
     page still says they exist, in the past tense;
   - allowances (gated build): assessment_usage counts each essay, recorded
     Speaking, live interview and mock or placement interview against the
     30 days (kind, purpose, status, times), and assessment_provider_usage
     keeps the AI service's usage figures, model and outcome for each call,
     never the essay, the audio or the reply (2026-09-30-profitable-offer.sql,
     src/lib/access/metering.ts);
   - complimentary access (Builder G, 2026-10-01-free-account.sql): an
     access_grants row of kind complimentary with its start, end and the
     admin who gave it;
   - purchases (re-audit R02, 30 September 2026), from
     supabase/migrations/2026-09-30-paid-access.sql and workers/payments:
     payment_orders keeps the plan, amount, currency, provider name and the
     provider's reference, status (created, pending, paid, failed, cancelled,
     refunded), a failure reason, the created/paid/refunded times and a
     receipt number; access_grants keeps each paid period's start and end and
     the time it was revoked. An order row exists from the moment a purchase
     is STARTED. Both tables reference the sign-in with ON DELETE RESTRICT,
     so an account with any order cannot be deleted today. Card details never
     reach our code: the Worker asks the provider for a checkout address and
     later receives a signed confirmation. No provider is chosen, so none is
     named. The site has no delete-my-account control at all;
   - signed-out support (re-audit R01, workers/support and
     2026-09-30-support.sql): the typed email, message, topic, language and
     the page named in the link are kept; the sender's network address only
     as a keyed hash (the /64 network for IPv6), used only for the per-sender
     limits, never shown to the admin and erased after 24 hours (on every
     signed-out message and hourly). The Turnstile check, only when its site
     key is configured, sends Cloudflare the token and the address; the site
     stores neither.
   If a Worker is ever switched to its Gemini rollback, the "OpenAI" lines
   below must change first.

   Deliberately NOT stated, because Alex has not decided them: who runs the
   site (shown on its own once src/lib/operator.ts is published), how long
   each kind of information is kept, and the full process for removing an
   account. The page says what happens TODAY (including the deletion limit
   above) and lists separately what is still undecided, because silence
   would read as "kept forever, never removable". */
import BaseLayout from '../layouts/BaseLayout.astro';
import { ACCOUNT_DELETION_ENABLED } from '../lib/auth/session';
import { SUPPORT_ENABLED } from '../lib/support';
import { withBase } from '../lib/url';
import { nt } from '../lib/i18n/translate';
import { publishedOperator } from '../lib/operator';
import { isTrialBuild } from '../lib/trial/mode';

const operator = publishedOperator();

const asked: { what: string; why: string }[] = [
  {
    what: nt('Email and password'),
    why: nt('To create your account, so your work stays yours and follows you to other devices. If you sign in with Google, Google shares your email address and name instead.'),
  },
  { what: nt('First and last name'), why: nt('So the course and Mr EZ can call you by name.') },
  {
    what: nt('Date of birth'),
    why: nt('Students under 18 also give a parent or guardian’s details, and your date of birth tells the form when that is needed.'),
  },
  { what: nt('Phone number'), why: nt('So we can contact you about your studies or your account if we need to.') },
  {
    what: nt('City, school or job, and how you found us'),
    why: nt('To understand who studies here and how people find the course.'),
  },
  {
    what: nt('A parent or guardian, under 18 only'),
    why: nt('Their name, their phone number and their agreement to you using the site. The time of that agreement is recorded.'),
  },
];

const kept: string[] = [
  nt('Lessons you finish, your test answers and results, your study plan and how much you study each day.'),
  nt('Essays you have had graded, with their feedback, so you can reread them later.'),
  nt('For Speaking, your scores. The recording itself is not saved by this site.'),
  nt('Your conversations with Mr EZ, so he can carry on where you left off. You can clear them at any time in Study plan settings.'),
  nt('If you took the free trial while it was offered: when it started, which trial tests and Mr EZ messages you used, and your answers to the short questions about your goals. The trial is no longer offered, so no new trial records are made.'),
  nt('Messages you send through the support form, with the page you sent them from.'),
  nt('If you write without signing in: the email address you give for the reply. To stop one sender from flooding the form, your internet connection’s address is also kept for 24 hours, only as a scrambled code that cannot be read back. The address itself is never stored.'),
  ...(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY
    ? [nt('When the form shows a security check, Cloudflare runs it and receives your connection’s address to do so. This site keeps nothing from the check.')]
    : []),
];

/* Purchases exist only in the gated build: the open site sells nothing and
   never creates a purchase record. */
const sellsAccess = isTrialBuild();
/* Self-service deletion (2 October 2026), where its database function exists. */
const selfDeletion = ACCOUNT_DELETION_ENABLED;

const purchaseRecord: string[] = [
  nt('Which plan you chose, its price and currency, and when you started the purchase.'),
  nt('What happened to it: waiting for payment, paid, not completed, cancelled or refunded, with the time, and a short reason if a payment did not go through.'),
  nt('The name of the payment company and its reference number for the payment.'),
  nt('A receipt number for each paid purchase.'),
  nt('The dates your paid access starts and ends, and the date it was withdrawn if a payment was refunded.'),
  nt('How many of the included assessments you have used: each essay, recorded Speaking, live interview and mock exam or placement interview, with its time and whether it finished.'),
  nt('For each AI assessment, the AI service’s usage figures and the result of the call, to keep costs in check. Your essay, your recording and the feedback text are not part of this record.'),
  nt('If the person who runs the site gives you free access, the dates it starts and ends and who gave it.'),
];

const undecided = selfDeletion
  ? nt('Still being decided: how long information is kept while an account stays open. This page will say so once it is.')
  : sellsAccess
    ? nt('Still being decided: how long each kind of information is kept, including purchase records, and the full process for removing an account. This page will say so once it is.')
    : nt('Still being decided: how long each kind of information is kept, and the full process for removing an account. This page will say so once it is.');

const services: { name: string; role: string }[] = [
  {
    name: 'Supabase',
    role: sellsAccess
      ? nt('Stores accounts, profiles, saved work, Mr EZ conversations, support messages and purchase records.')
      : nt('Stores accounts, profiles, saved work, Mr EZ conversations and support messages.'),
  },
  {
    name: 'OpenAI',
    role: nt('Writes the AI feedback and Mr EZ’s replies. Your essay text, your Speaking recording, and your questions to Mr EZ with a summary of your own results are sent to OpenAI for this, under OpenAI’s own terms for its API.'),
  },
  {
    name: 'Cloudflare',
    role: nt('Runs the small services that check your account and pass your work to OpenAI, so the AI keys never reach your browser.'),
  },
];
---

<BaseLayout title="Privacy · IELTS is EZ" description="How IELTS is EZ uses your information: what it asks for and why, what it keeps, and which services handle it.">
  <article class="policy">
    <header class="policy-head">
      <p class="policy-eyebrow" data-i18n>Privacy</p>
      <h1 data-i18n>How your information is used</h1>
      <p class="policy-lede" data-i18n>What the site asks for and why, what it keeps, and which services handle it. Only what the site actually does, in plain words.</p>
      <p class="policy-updated" data-i18n>Updated 1 October 2026</p>
    </header>

    {operator && (
      <section class="policy-section" aria-labelledby="privacy-who">
        <h2 id="privacy-who" data-i18n>Who is responsible</h2>
        <dl class="policy-services">
          <div>
            <dt data-i18n>Run by</dt>
            <dd>{operator.name}</dd>
          </div>
          {operator.contact && (
            <div>
              <dt data-i18n>Contact</dt>
              <dd>{operator.contactHref ? <a href={operator.contactHref}>{operator.contact}</a> : operator.contact}</dd>
            </div>
          )}
        </dl>
      </section>
    )}

    <section class="policy-section" aria-labelledby="privacy-asked">
      <h2 id="privacy-asked" data-i18n>What we ask for, and why</h2>
      <ul class="policy-list">
        {asked.map((item) => (
          <li>
            <strong data-i18n>{item.what}</strong>
            <br />
            <span data-i18n>{item.why}</span>
          </li>
        ))}
      </ul>
      <p style="margin-top: 16px" data-i18n>Your details are seen only by you and by the person who runs the site, on a private admin page. Other students never see them.</p>
    </section>

    <section class="policy-section" aria-labelledby="privacy-kept">
      <h2 id="privacy-kept" data-i18n>What the site keeps from your studies</h2>
      <ul class="policy-list">
        {kept.map((line) => <li data-i18n>{line}</li>)}
      </ul>
      <p style="margin-top: 16px" data-i18n>Your progress is also kept in this browser, on this device. Signing in keeps it on your account too.</p>
    </section>

    {sellsAccess && (
      <section class="policy-section" aria-labelledby="privacy-purchases">
        <h2 id="privacy-purchases" data-i18n>Purchases and payment records</h2>
        <p data-i18n>When you buy practice and guidance, or are given it, the site keeps these records:</p>
        <ul class="policy-list">
          {purchaseRecord.map((line) => <li data-i18n>{line}</li>)}
        </ul>
        <p style="margin-top: 16px" data-i18n>A purchase that you start and do not finish is recorded too.</p>
        <p data-i18n>Card details are entered on the payment company’s own page. This site does not receive or keep them.</p>
        <p data-i18n>You can see your own purchases and receipts on your Account page. Other students cannot see them.</p>
        <p data-i18n>No payment company is connected yet, so buying is not open. When one is chosen, this page will name it and say what it receives.</p>
      </section>
    )}

    <section class="policy-section" aria-labelledby="privacy-services">
      <h2 id="privacy-services" data-i18n>Which services handle it</h2>
      <dl class="policy-services">
        {services.map((s) => (
          <div>
            <dt>{s.name}</dt>
            <dd data-i18n>{s.role}</dd>
          </div>
        ))}
      </dl>
      <p style="margin-top: 16px" data-i18n>In a live Speaking interview, your voice goes straight from your browser to OpenAI. It does not pass through this site, which keeps only a short record of when the interview started and ended, to apply the daily limits.</p>
    </section>

    <section class="policy-section" aria-labelledby="privacy-young">
      <h2 id="privacy-young" data-i18n>Younger students</h2>
      <p data-i18n>If you are under 18, the profile asks for a parent or guardian’s name and phone number, and for their agreement, before you can continue.</p>
      <p data-i18n>Please read this page together with them.</p>
    </section>

    {/* Only where the support form can send (src/lib/support.ts). */}
    {SUPPORT_ENABLED && (
    <section class="policy-section" aria-labelledby="privacy-questions">
      <h2 id="privacy-questions" data-i18n>Questions about your information</h2>
      <p data-i18n>Ask through the support form. A person reads every message and replies by email.</p>
      <p><a class="policy-action" href={withBase('/support?reason=privacy')} data-i18n>Ask a person</a></p>
    </section>
    )}

    <section class="policy-section" aria-labelledby="privacy-removal">
      <h2 id="privacy-removal" data-i18n>Removing your account</h2>
      {selfDeletion ? (
        <>
          <p data-i18n>You can delete your account yourself at any time: open Account, then Profile, then Delete account.</p>
          <p data-i18n>Everything is removed at once and cannot be recovered: your details, your progress and results, your essays and speaking feedback, your saved items and notes, your study plan, your conversations with Mr EZ and your messages to us. Any access you have paid for ends.</p>
          {sellsAccess && (
            <p data-i18n>A record of each payment (the plan, the amount, the date and the receipt number) is kept without your name or email, because sales records must be kept by law.</p>
          )}
        </>
      ) : (
        <>
          <p data-i18n>The site has no button for deleting an account yet. To ask about removing your account or your information, use the support form.</p>
          {sellsAccess && (
            <p data-i18n>One limit applies today. An account that has any purchase record cannot be deleted, because purchase records are kept. This includes a purchase that was started and never paid.</p>
          )}
        </>
      )}
      <p class="policy-note" role="note" data-i18n>{undecided}</p>
      <p class="policy-foot">
        <a href={withBase('/terms')} data-i18n>Terms of use</a>
        <a href={withBase('/help')} data-i18n>How the platform works</a>
      </p>
    </section>
  </article>
</BaseLayout>

<style is:global>
  @import '../styles/trust-pages.css';
</style>
