---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Course from '../components/Course';
import MrEzMemory from '../components/tutor/MrEzMemory';
---
<BaseLayout title="Plan settings · IELTS Portal" description="Change your target band, exam date and study schedule.">
  <div class="settings-page platform-hub mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <SectionHeading level="h1" title="Your study plan" subtitle="Set your target, exam date and study time. Your completed lessons stay saved." />
    <Course settingsOnly client:load />
    <div class="mt-10"><MrEzMemory client:load /></div>
  </div>
</BaseLayout>
<style is:global>
  @import '../styles/platform-pages.css';
</style>
