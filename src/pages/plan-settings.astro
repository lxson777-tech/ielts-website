---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Course from '../components/Course';
---
<BaseLayout title="Plan settings · IELTS Portal" description="Change your target band, exam date and study schedule.">
  <div class="platform-hub mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <SectionHeading title="Your study plan" subtitle="Set your target, exam date and study time. Your completed lessons stay saved." />
    <Course settingsOnly client:load />
  </div>
</BaseLayout>
<style is:global>
  @import '../styles/platform-pages.css';
</style>
