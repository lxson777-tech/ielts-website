---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CueCardBank from '../../components/CueCardBank';
import { CUE_CARDS } from '../../data/cue-cards';
import PaidContent from '../../components/trial/PaidContent';
import { ACCESS_MODE } from '../../lib/trial/mode';

/* The gated build (PUBLIC_ACCESS_MODE=trial) writes none of this page's
   material into it: a paid account's browser receives it through the content
   gate, and PaidContent mounts the tool once it is in. */
const gated = ACCESS_MODE === 'trial';
---

<BaseLayout
  title="Cue Card Bank · IELTS Portal"
  trialGate={{ kind: 'locked', title: 'Cue Card Bank', paidContent: true, feature: 'cue-cards' }}
  description={`${CUE_CARDS.length} original Speaking Part 2 cue cards covering every topic family in the real exam, each with a one-minute prep plan, a Band 7.0 model answer, Band 8 upgrade phrases, and Part 3 follow-up questions.`}
>
  <div class="skill-speaking mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <SectionHeading level="h1"
      eyebrow="Speaking"
      title="Cue Card Bank"
      subtitle="Choose a topic, prepare for one minute, then speak. Each card includes a model answer and follow-up questions."
    />
    {gated ? <PaidContent client:load view={{ name: 'cue-card-bank' }} /> : <CueCardBank client:load />}
  </div>
</BaseLayout>
