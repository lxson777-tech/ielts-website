---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaidContent from '../../components/trial/PaidContent';
import SpeakingTester from '../../components/SpeakingTester';
import { isTrialBuild } from '../../lib/trial/mode';
---
<BaseLayout title="Recorded Speaking · IELTS Portal" trialGate={{kind:'speaking',title:'Speaking'}}>
  <div class="skill-speaking mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <h1 class="text-3xl font-extrabold" data-i18n>Speaking</h1>
    {isTrialBuild() ? <PaidContent client:load shared view={{name:'recorded'}} /> : <SpeakingTester client:load />}
  </div>
</BaseLayout>
