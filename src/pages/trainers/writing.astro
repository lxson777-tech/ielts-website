---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import WritingTester from '../../components/WritingTester';
import WritingHistory from '../../components/WritingHistory';
import { withBase } from '../../lib/url';
---

<BaseLayout
  title="Writing Trainer · IELTS Portal"
  description="Write an IELTS essay with a live coach panel of structures, phrases and topic vocabulary, and get instant feedback: word count, vocabulary range, cohesion, spelling, and band-by-band comments."
>
  <div class="skill-writing writing-trainer-page mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <SectionHeading level="h1"
      eyebrow="Writing"
      title="Writing Trainer"
      subtitle="Write an exam-style answer with a coach beside you. Then review feedback on the four IELTS criteria."
    />
    <WritingTester client:load />

    <p class="mt-6 text-center text-sm">
      <a href={withBase('/writing/checker')} class="font-semibold text-brand hover:underline" data-i18n>
        Ready to write without help? Take it under exam conditions in the Writing Checker
      </a>
    </p>

    {/* The model answer bank had no entry point while it was empty. Every one
        of these 60 tasks now has a Band 8 model, so link it where a student
        finishes writing and wants to compare. */}
    <a
      href={withBase('/writing/models')}
      class="mt-6 flex items-center justify-between gap-3 rounded-card border border-border bg-surface px-5 py-4 text-sm shadow-card transition-colors hover:border-brand"
    >
      <span>
        <span class="font-display font-bold text-ink" data-i18n>Model answers</span>
        <span class="mt-0.5 block text-ink-muted" data-i18n>
          A Band 8 answer for every task here, with examiner notes on all four criteria.
        </span>
      </span>
      <span aria-hidden="true" class="shrink-0 text-brand">&rarr;</span>
    </a>

    <section id="history" class="mt-16 scroll-mt-20">
      <SectionHeading title="Your score history" subtitle="Attempts are stored in your browser, no account needed." />
      <WritingHistory client:load />
    </section>
  </div>
</BaseLayout>

<style is:global>
  @import '../../styles/platform-pages.css';
</style>
