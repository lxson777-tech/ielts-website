---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import WritingTester from '../../components/WritingTester';
import WritingHistory from '../../components/WritingHistory';
import { withBase } from '../../lib/url';
---

<BaseLayout
  title="Writing Trainer · IELTS Portal"
  description="Write an IELTS essay with a live coach panel of structures, phrases and topic vocabulary, and get instant feedback: word count, vocabulary range, cohesion, spelling, and band-by-band comments."
>
  <div class="skill-writing writing-trainer-page mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <SectionHeading
      eyebrow="Writing"
      title="Writing Trainer"
      subtitle="Press start to get an exam-style task, a different one every time. A coach panel with the paragraph plan, useful phrases and topic vocabulary stays beside you while you write, then you get instant feedback on the four IELTS criteria."
    />
    <WritingTester client:load />

    <p class="mt-6 text-center text-sm">
      <a href={withBase('/writing/checker')} class="font-semibold text-brand hover:underline">
        Ready to write without help? Take it under exam conditions in the Writing Checker
      </a>
    </p>

    <section id="history" class="mt-16 scroll-mt-20">
      <SectionHeading title="Your score history" subtitle="Attempts are stored in your browser, no account needed." />
      <WritingHistory client:load />
    </section>
  </div>
</BaseLayout>

<style is:global>
  @import '../../styles/platform-pages.css';
</style>
