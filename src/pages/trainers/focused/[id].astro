---
/* One focused exercise, resolved against the real material at build time.
 *
 * The data (src/data/focused-exercises.ts) names either a paper, a part and
 * a question group, or a real exam prompt. src/lib/tests/focused-views.ts
 * is where that becomes a passage and six questions with an answer key, or a
 * chart and the band 8 overview written for it; this page hands the result
 * to its island. Nothing is carried by the catalogue, which is the same
 * split the drill pages use: src/data/tests is 3.9 MB and belongs on the
 * build side of the line.
 *
 * If a named group or prompt is not there, or is not the type the exercise
 * claims, the build FAILS rather than shipping an empty page.
 *
 * The gated build (PUBLIC_ACCESS_MODE=trial) writes no exercise into the
 * page. A paid account's browser receives the same view through the content
 * gate (the pack `focused-<id>`, written by tools/build-gated-content.mjs
 * from the same function), and PaidContent mounts the exercise once it is in.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ACCESS_MODE } from '../../../lib/trial/mode';
import FocusedExercise from '../../../components/learning/FocusedExercise';
import WritingFocusedTask from '../../../components/learning/WritingFocusedTask';
import PaidContent from '../../../components/trial/PaidContent';
import { ALL_FOCUSED_EXERCISES, isAuthoredFocusedExercise, type AnyFocusedExercise } from '../../../data/focused-exercises';
import { focusedPageView } from '../../../lib/tests/focused-views';

/* Every English lesson body, read at build time only, so an exercise can
   point at the exact teaching block that explains it. Same glob the
   lesson-block endpoint uses. */
const LESSON_BODIES = import.meta.glob<string>('../../../content/lesson-bodies/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});

export function getStaticPaths() {
  return ALL_FOCUSED_EXERCISES.map((exercise) => ({ params: { id: exercise.id }, props: { exercise } }));
}

const { exercise } = Astro.props as { exercise: AnyFocusedExercise };

/* Resolved in both builds, so a broken reference fails the gated build too. */
const { written: writtenView, item: itemView } = focusedPageView(
  exercise,
  (key) => LESSON_BODIES[`../../../content/lesson-bodies/${key}.html`],
);

const description = writtenView
  ? 'A short focused writing task on one objective, built from a real exam prompt.'
  : isAuthoredFocusedExercise(exercise)
    ? 'A short focused practice set written for this site, not a real exam question.'
    : 'A short focused exercise on one question type, built from real exam material.';
const gated = ACCESS_MODE === 'trial';
---

<BaseLayout wide title={`${exercise.title} · IELTS Portal`} description={description} trialGate={{ kind: 'locked', title: exercise.title, paidContent: true }}>
  {/* The gated build carries only the gate and, for a paid account, the
      exercise from the content gate: never its passage or questions. */}
  {gated && <PaidContent client:load view={{ name: 'focused', id: exercise.id }} />}
  {!gated && writtenView && <WritingFocusedTask client:load view={writtenView} />}
  {!gated && itemView && <FocusedExercise client:load view={itemView} />}
</BaseLayout>
