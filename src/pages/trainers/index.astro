---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PracticeOrTest from '../../components/PracticeOrTest.astro';
import { withBase } from '../../lib/url';
import Count from '../../components/Count.astro';
import { nt, ntn, type CountedPhrase } from '../../lib/i18n/translate';
import { ALL_DRILLS, ALL_LISTENING_DRILLS } from '../../lib/tests/drills';
import { SPEAKING_PART1_TOPICS, SPEAKING_CUE_CARDS } from '../../data/speaking-prompts';
import { WRITING_PROMPTS } from '../../data/writing-prompts';
import { ACCESS_MODE } from '../../lib/trial/mode';
import type { TrialSection } from '../../lib/trial/offer';

const task1Count = WRITING_PROMPTS.filter((p) => p.task === 'task1').length;
const task2Count = WRITING_PROMPTS.filter((p) => p.task === 'task2').length;

/* The gated build (PUBLIC_ACCESS_MODE=trial, the free-account model of
   1 October 2026): every trainer comes with practice and guidance. The tiles
   read the same for everyone; for an account without it a tile's link opens
   the upgrade pop-up (src/lib/access/paid-guard.ts), and one quiet line says
   so before the click. The open build is unchanged. */
const trialBuild = ACCESS_MODE === 'trial';

const trainers: {
  skill: TrialSection;
  title: string;
  description: string;
  perk: string;
  stats: CountedPhrase[];
  href: string;
  cta: string;
  image: string;
}[] = [
  {
    skill: 'reading',
    title: 'Reading Trainer',
    description: nt("Read one passage with strategy tips, then review your answers."),
    perk: 'Strategy panel and trap warnings while you read',
    // Counted phrases, rendered with <Count> so Russian gets the right form.
    stats: [ntn(ALL_DRILLS.length, { one: '{n} drill', other: '{n} drills' })],
    href: '/trainers/reading',
    cta: nt('Start a drill'),
    image: '/pics/trainers/reading-drill.png',
  },
  {
    skill: 'listening',
    title: 'Listening Trainer',
    description: nt("Listen to one recording. Pause and replay while you practise."),
    perk: 'Pause, seek and replay while you practise',
    stats: [ntn(ALL_LISTENING_DRILLS.length, { one: '{n} drill', other: '{n} drills' })],
    href: '/trainers/listening',
    cta: nt('Start a drill'),
    image: '/pics/tests/listening-exam.svg',
  },
  {
    skill: 'speaking',
    title: 'Speaking Trainer',
    description: nt("Speak through one part of the exam, with guidance when you need it."),
    perk: 'Coach panel with structure, phrases and idea hints',
    stats: [
      ntn(SPEAKING_PART1_TOPICS.length, { one: '{n} Part 1 topic', other: '{n} Part 1 topics' }),
      ntn(SPEAKING_CUE_CARDS.length, { one: '{n} cue card', other: '{n} cue cards' }),
    ],
    href: '/trainers/speaking',
    cta: nt('Start a part'),
    image: '/pics/trainers/speaking-drill.png',
  },
  {
    skill: 'writing',
    title: 'Writing Trainer',
    description: nt("Write an answer with a paragraph plan, then review your feedback."),
    perk: 'Coach panel with a paragraph plan and instant feedback',
    stats: [
      ntn(task1Count, { one: '{n} Task 1 prompt', other: '{n} Task 1 prompts' }),
      ntn(task2Count, { one: '{n} Task 2 prompt', other: '{n} Task 2 prompts' }),
    ],
    href: '/trainers/writing',
    cta: nt('Start writing'),
    image: '/pics/trainers/writing-drill.png',
  },
];
---

<BaseLayout
  title="Trainers · IELTS Portal"
  description="Coached, single-skill practice with hints and feedback on every attempt: the guided alternative to a full timed exam."
>
  <div class="platform-hub mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <header class="hub-heading"><div><h1 data-i18n>Practice, at your pace.</h1><p data-i18n>Build one skill at a time, with a coach beside you.</p></div><span class="hub-mode" data-i18n>Guided practice</span></header>
    {trialBuild && (
      <p class="mb-6 max-w-2xl text-sm text-ink" data-access-copy="free" data-i18n>
        Guided practice comes with practice and guidance. Every lesson stays free with your account.
      </p>
    )}
    <div class="practice-grid">
      {trainers.map((t) => (
        <article class={`practice-tile skill-${t.skill}`}>
          <div class="practice-tile-top"><img src={withBase(t.image)} alt="" width="56" height="56" /><span>{t.stats.map((phrase, i) => <>{i > 0 && ' · '}<Count phrase={phrase} /></>)}</span></div>
          <h2>{t.title.replace(' Trainer', '')}</h2>
          <p data-i18n>{t.description.replace('instant AI feedback', 'AI feedback')}</p>
          <a href={withBase(t.href)} class="activity-start"><span data-i18n>{t.cta}</span><span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
    {/* The two study banks' home since the account menu was shortened
        (2 October 2026). For an account without practice and guidance the
        links open the upgrade pop-up, like the tiles above. */}
    <p class="practice-banks">
      <span data-i18n>Study from examples:</span>
      <a href={withBase('/writing/models')} data-i18n>Model answers</a>
      <span aria-hidden="true">·</span>
      <a href={withBase('/speaking/cue-cards')} data-i18n>Cue cards</a>
    </p>
    <PracticeOrTest current="practice" />
    <p class="mt-8 text-center text-sm">
      <a href={withBase('/tests')} class="font-semibold text-brand hover:underline" data-i18n>
        Looking for a full timed exam instead?
      </a>
    </p>
  </div>
</BaseLayout>

<style is:global>
  @import '../../styles/platform-pages.css';
</style>

