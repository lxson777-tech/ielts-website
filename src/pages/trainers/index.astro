---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PracticeOrTest from '../../components/PracticeOrTest.astro';
import { withBase } from '../../lib/url';
import { nt } from '../../lib/i18n/translate';
import { ALL_DRILLS, ALL_LISTENING_DRILLS } from '../../lib/tests/drills';
import { SPEAKING_PART1_TOPICS, SPEAKING_CUE_CARDS } from '../../data/speaking-prompts';
import { WRITING_PROMPTS } from '../../data/writing-prompts';
import { ACCESS_MODE } from '../../lib/trial/mode';
import { TRIAL_FULL_ACCESS_LABEL, TRIAL_OFFER, type TrialSection } from '../../lib/trial/offer';

const task1Count = WRITING_PROMPTS.filter((p) => p.task === 'task1').length;
const task2Count = WRITING_PROMPTS.filter((p) => p.task === 'task2').length;

/* A trial build (PUBLIC_ACCESS_MODE=trial): no trainer is part of the trial,
   so each tile says so BEFORE the click and offers what the trial does
   include for that section, its lesson and its test (audit F03). A paid
   account gets the ordinary tiles back once the server confirms it
   (src/lib/trial/hub.ts); the open build is unchanged. */
const trialBuild = ACCESS_MODE === 'trial';

const trainers: {
  skill: TrialSection;
  title: string;
  description: string;
  perk: string;
  stats: string;
  href: string;
  cta: string;
  image: string;
}[] = [
  {
    skill: 'reading',
    title: 'Reading Trainer',
    description: nt("Read one passage with strategy tips, then review your answers."),
    perk: 'Strategy panel and trap warnings while you read',
    // A build-time count baked into plain text: no counted-phrase mechanism
    // reaches text this dynamic without touching src/lib/i18n, so it is left
    // English (see batch report).
    stats: `${ALL_DRILLS.length} drills`,
    href: '/trainers/reading',
    cta: nt('Start a drill'),
    image: '/pics/trainers/reading-drill.png',
  },
  {
    skill: 'listening',
    title: 'Listening Trainer',
    description: nt("Listen to one recording. Pause and replay while you practise."),
    perk: 'Pause, seek and replay while you practise',
    stats: `${ALL_LISTENING_DRILLS.length} drills`,
    href: '/trainers/listening',
    cta: nt('Start a drill'),
    image: '/pics/tests/listening-exam.svg',
  },
  {
    skill: 'speaking',
    title: 'Speaking Trainer',
    description: nt("Speak through one part of the exam, with guidance when you need it."),
    perk: 'Coach panel with structure, phrases and idea hints',
    stats: `${SPEAKING_PART1_TOPICS.length} Part 1 topics · ${SPEAKING_CUE_CARDS.length} cue cards`,
    href: '/trainers/speaking',
    cta: nt('Start a part'),
    image: '/pics/trainers/speaking-drill.png',
  },
  {
    skill: 'writing',
    title: 'Writing Trainer',
    description: nt("Write an answer with a paragraph plan, then review your feedback."),
    perk: 'Coach panel with a paragraph plan and instant feedback',
    stats: `${task1Count} Task 1 prompts · ${task2Count} Task 2 prompts`,
    href: '/trainers/writing',
    cta: nt('Start writing'),
    image: '/pics/trainers/writing-drill.png',
  },
];
---

<BaseLayout
  title="Trainers · IELTS Portal"
  description="Coached, single-skill practice with hints and feedback on every attempt: the guided alternative to a full timed exam."
>
  <div class="platform-hub mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <header class="hub-heading"><div><h1 data-i18n>Practice, at your pace.</h1><p data-i18n>Build one skill at a time, with a coach beside you.</p></div><span class="hub-mode" data-i18n>Guided practice</span></header>
    {trialBuild && (
      <p class="mb-6 max-w-2xl text-sm text-ink" data-access-copy="trial" data-i18n>
        Guided practice comes with full access. Your trial includes one lesson and one test in each section, linked on each card below.
      </p>
    )}
    <div class="practice-grid">
      {trainers.map((t) => (
        <article class={`practice-tile skill-${t.skill}`}>
          <div class="practice-tile-top"><img src={withBase(t.image)} alt="" width="56" height="56" /><span>{t.stats}</span></div>
          <h2>{t.title.replace(' Trainer', '')}</h2>
          <p data-i18n>{t.description.replace('instant AI feedback', 'AI feedback')}</p>
          {trialBuild && (
            <div data-access-copy="trial" class="mt-auto flex flex-col gap-2 pt-4">
              <p class="flex items-center gap-1.5 text-xs font-semibold text-ink-muted">
                <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="2" y="5.2" width="8" height="5.6" rx="1.2" /><path d="M3.8 5.2V3.8a2.2 2.2 0 0 1 4.4 0v1.4" /></svg>
                <span data-i18n>{TRIAL_FULL_ACCESS_LABEL}</span>
              </p>
              <a href={withBase(TRIAL_OFFER[t.skill].lessonHref)} class="activity-start"><span data-i18n>Open the included lesson</span><span aria-hidden="true">↗</span></a>
              <a href={withBase(TRIAL_OFFER[t.skill].testHref)} class="text-xs font-semibold text-[var(--skill)] hover:underline" data-trial-section={t.skill} data-full-label="Take the included test" data-full-href={TRIAL_OFFER[t.skill].testHref}>
                Take the included test
              </a>
              <p class="text-xs leading-relaxed text-ink" data-trial-note={t.skill} aria-live="polite" hidden></p>
            </div>
          )}
          <a href={withBase(t.href)} class="activity-start" data-access-copy={trialBuild ? 'full' : undefined} hidden={trialBuild}><span data-i18n>{t.cta}</span><span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
    <PracticeOrTest current="practice" />
    <p class="mt-8 text-center text-sm">
      <a href={withBase('/tests')} class="font-semibold text-brand hover:underline" data-i18n>
        Looking for a full timed exam instead?
      </a>
    </p>
  </div>
</BaseLayout>

<style is:global>
  @import '../../styles/platform-pages.css';
</style>

<script>
  import { isTrialBuild } from '../../lib/trial/mode';

  /* A trial build: each tile's included-test link follows the student's own
     allowance, and a paid account gets the ordinary tiles back. */
  function init() {
    if (isTrialBuild()) void import('../../lib/trial/hub').then((m) => m.initTrialHub());
  }
  document.addEventListener('astro:page-load', init);
  init();
</script>
