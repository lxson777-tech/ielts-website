---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import LiveExaminer from '../../components/LiveExaminer';
import SpeakingTester from '../../components/SpeakingTester';
import SpeakingHistory from '../../components/SpeakingHistory';
import { withBase } from '../../lib/url';

/* The trainer is the live examiner scoped to one part (same tech as
   /speaking/examiner). When the live token service isn't configured at
   build time, fall back to the older record-then-grade checker so the
   trainer never disappears. */
const liveConfigured = !!import.meta.env.PUBLIC_LIVE_EXAMINER_URL;
---

<BaseLayout
  title="Speaking Trainer · IELTS Portal"
  description="Practice IELTS Speaking Part 1, 2 or 3 as a live voice conversation with an AI examiner, with an interactive coach panel of structures, phrases and topic vocabulary, and a full band report."
>
  <div class="skill-speaking mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <SectionHeading
      eyebrow="Speaking"
      title="Speaking Trainer"
      subtitle={liveConfigured
        ? 'Pick a part and talk to the AI examiner in a real voice conversation. She asks the questions out loud, follows up on your answers, and grades you on the four official IELTS Speaking criteria, while a coach panel keeps structures, phrases and topic vocabulary at hand.'
        : 'Pick a part. Record your answers with your microphone and an AI examiner grades you on the four official IELTS Speaking criteria, while a coach panel keeps structures, phrases and topic vocabulary at hand.'}
    />
    {liveConfigured ? <LiveExaminer client:load variant="drills" /> : <SpeakingTester client:load />}

    <a href={withBase('/speaking/cue-cards')} class="skill-resource-card">
      <span class="skill-resource-card-title">Cue-card bank (for study, not a test)</span>
      <span class="skill-resource-card-desc">Read 24 Part 2 cue cards with model answers, to prepare before you speak</span>
    </a>

    <section id="history" class="mt-16 scroll-mt-20">
      <SectionHeading title="Your score history" subtitle="Attempts are stored in your browser, no account needed." />
      <SpeakingHistory client:load />
    </section>
  </div>
</BaseLayout>

<style is:global>
  @import '../../styles/platform-pages.css';
</style>
