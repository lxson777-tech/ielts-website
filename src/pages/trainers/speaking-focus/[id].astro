---
/* One spoken focused task, resolved against the real prompt bank at build
 * time (src/lib/tests/focused-views.ts). Its own small route,
 * deliberately separate from ../focused/[id].astro (see SpokenFocusedTask's
 * header comment in src/data/focused-exercises.ts for why): a Part 1 topic
 * or a cue card is a different shape from a passage or a written prompt, and
 * this page's job is only to turn a real prompt id into the one question the
 * student answers, never to invent one.
 *
 * If a named prompt is not there, the build FAILS rather than shipping an
 * empty page, the same rule every focused route holds to.
 *
 * The gated build (PUBLIC_ACCESS_MODE=trial) writes no task into the page:
 * a paid account's browser receives the same view through the content gate
 * (the pack `speaking-focus-<id>`), and PaidContent mounts it.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ACCESS_MODE } from '../../../lib/trial/mode';
import SpokenFocusedTask from '../../../components/learning/SpokenFocusedTask';
import PaidContent from '../../../components/trial/PaidContent';
import { SPOKEN_FOCUSED_TASKS, type SpokenFocusedTask as SpokenFocusedTaskData } from '../../../data/focused-exercises';
import { spokenTaskView } from '../../../lib/tests/focused-views';

const LESSON_BODIES = import.meta.glob<string>('../../../content/lesson-bodies/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});

export function getStaticPaths() {
  return SPOKEN_FOCUSED_TASKS.map((task) => ({ params: { id: task.id }, props: { task } }));
}

const { task } = Astro.props as { task: SpokenFocusedTaskData };

/* Resolved in both builds, so a broken reference fails the gated build too. */
const view = spokenTaskView(task, (key) => LESSON_BODIES[`../../../content/lesson-bodies/${key}.html`]);
const gated = ACCESS_MODE === 'trial';
---

<BaseLayout
  wide
  title={`${task.title} · IELTS Portal`}
  trialGate={{ kind: 'locked', title: task.title, paidContent: true }}
  description="A short self-check speaking task on one objective, built from a real Speaking prompt."
>
  {/* The gated build carries only the gate and, for a paid account, the
      task from the content gate. */}
  {gated ? <PaidContent client:load view={{ name: 'speaking-focus', id: task.id }} /> : <SpokenFocusedTask client:load view={view} />}
</BaseLayout>
