---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GatedTestPlayer from '../../../components/trial/GatedTestPlayer';
import { ACCESS_MODE } from '../../../lib/trial/mode';
import TestPlayer from '../../../components/TestPlayer';
import { withBase } from '../../../lib/url';
import { ALL_DRILLS } from '../../../lib/tests/drills';

export function getStaticPaths() {
  return ALL_DRILLS.map((d) => ({ params: { id: d.id }, props: { test: d.test } }));
}

const { test } = Astro.props;
/* A trial build puts only the paper's id and title on the page; the paper
   itself comes from the content gate (GatedTestPlayer). */
const gated = ACCESS_MODE === 'trial';
---

<BaseLayout title={`${test.title} · IELTS Reading Drill`} bare>
  <div class="skill-reading">
    {gated ? (
      <GatedTestPlayer client:load testId={test.id} title={test.title} section={'Reading'} hubUrl={withBase('/trainers/reading')} attemptKind="drill" />
    ) : (
      <TestPlayer client:load test={test} hubUrl={withBase('/trainers/reading')} attemptKind="drill" />
    )}
  </div>
</BaseLayout>
