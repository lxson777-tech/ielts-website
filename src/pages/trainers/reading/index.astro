---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import CatalogueControls from '../../../components/CatalogueControls.astro';
import Badge from '../../../components/Badge.astro';
import { withBase } from '../../../lib/url';
import { ALL_DRILLS } from '../../../lib/tests/drills';
import { LABELS as QUESTION_TYPE_LABELS } from '../../../components/TypeAnalytics';

/* Group drills by their source test so the picker reads as "Test 1 → its
   3 passages" rather than one flat list of 15. */
const bySource = new Map<string, { sourceTitle: string; drills: typeof ALL_DRILLS }>();
for (const d of ALL_DRILLS) {
  const bucket = bySource.get(d.sourceTestId) ?? { sourceTitle: d.sourceTitle, drills: [] };
  bucket.drills.push(d);
  bySource.set(d.sourceTestId, bucket);
}

/* The distinct question types a drill's single passage contains, used to
   power the `?type=` filter from TypeAnalytics' "Practise this type" link
   (see the inline script below — this is a static page, so filtering by a
   query param has to happen client-side, after load). */
function drillTypes(drill: (typeof ALL_DRILLS)[number]): string[] {
  const seen = new Set<string>();
  for (const group of drill.test.parts[0]!.groups) seen.add(group.type);
  return [...seen];
}
---

<BaseLayout
  title="Reading Trainer · IELTS Portal"
  description="Timed single-passage reading drills with live strategy coaching: practice pace on one passage without a full 60-minute exam."
>
  <div class="skill-reading mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <a href={withBase('/trainers')} class="inline-block py-2 -my-2 text-sm font-semibold text-ink-muted hover:text-ink" data-i18n>All trainers</a>

    <SectionHeading level="h1"
      eyebrow="Reading"
      title="Reading Trainer"
      subtitle="Practise one passage at a time. Get instant scoring and guidance for each question type."
    />

    <section data-discovery>
    <CatalogueControls types={QUESTION_TYPE_LABELS} />
    <div class="rounded-card border border-border bg-surface shadow-card divide-y divide-border">
      {[...bySource.values()].map(({ sourceTitle, drills }) => (
        <div class="p-4 sm:p-5" data-discovery-group>
          <div class="mb-3 flex items-baseline justify-between gap-3">
            <h3 class="font-display text-sm font-bold">{sourceTitle}</h3>
            <span class="shrink-0 text-xs font-semibold text-ink-muted">{drills.length} passages</span>
          </div>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            {drills.map((d) => (
              <a
                href={withBase(`/trainers/reading/${d.id}`)}
                data-discovery-item data-minutes={d.test.durationMinutes} data-search={sourceTitle} data-drill-types={drillTypes(d).join(',')}
                class="group flex flex-col gap-1 rounded-lg border border-border p-3 transition-colors hover:border-[var(--skill,var(--color-brand))]"
              >
                <Badge tone="skill" class="self-start">{d.test.parts[0]!.label}</Badge>
                <p class="font-display text-sm font-bold leading-snug group-hover:text-[var(--skill,var(--color-brand))]">
                  {d.test.parts[0]!.stimulus.kind === 'passage' ? d.test.parts[0]!.stimulus.title : d.test.parts[0]!.label}
                </p>
                <p class="mt-auto text-xs text-ink-muted">
                  {d.test.parts[0]!.groups.reduce((s, g) => s + g.questions.length, 0)} questions · {d.test.durationMinutes} min
                </p>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
    <p data-catalogue-empty hidden class="discovery-empty" data-i18n>No matches. Try another search.</p>
    <button type="button" data-catalogue-more class="discovery-more" data-i18n>Show more</button>
    </section>
  </div>

</BaseLayout>
