---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameStudent from '../components/home/GameStudent.astro';
import { withBase } from '../lib/url';
import '../styles/home-journey.css';

const skills = [
  { skill: 'Reading', state: 'read', title: 'Find the answer without reading every word.', bullets: ['Spot paraphrases between the question and passage.', 'Understand what every question type is really asking.', 'Find and check exact evidence under time pressure.'], link: withBase('/trainers/reading'), label: 'Explore Reading practice' },
  { skill: 'Listening', state: 'listen', title: 'Know what to listen for before it arrives.', bullets: ['Predict whether the answer is a name, number, date, or place.', 'Follow signposts and catch speakers who correct themselves.', 'Rehearse all four parts, from everyday details to academic discussion.'], link: withBase('/trainers/listening'), label: 'Explore Listening practice' },
  { skill: 'Writing', state: 'write', title: 'Turn a blank page into a clear argument.', bullets: ['Plan Task 1 and Task 2 before the clock runs away.', 'Build supported paragraphs with a topic, explanation, and example.', 'Use AI feedback to see strengths, corrections, and your next priority.'], link: withBase('/trainers/writing'), label: 'Try AI Writing feedback' },
  { skill: 'Speaking', state: 'speak', title: 'Speak with structure, even when you feel nervous.', bullets: ['Shape Part 1, Part 2, and Part 3 answers with simple frameworks.', 'Build natural vocabulary for common IELTS topics.', 'Practise aloud with guidance and AI voice feedback.'], link: withBase('/speaking/examiner'), label: 'Meet the AI Speaking examiner' },
];

const heroSkills = [
  { skill: 'Reading', promise: 'Find answers without reading every word.', points: ['Spot paraphrases', 'Check exact evidence'] },
  { skill: 'Listening', promise: 'Know what to listen for before it arrives.', points: ['Predict the answer type', 'Catch signposts and corrections'] },
  { skill: 'Writing', promise: 'Turn a blank page into a clear argument.', points: ['Plan a strong structure', 'Improve with AI feedback'] },
  { skill: 'Speaking', promise: 'Speak with structure when nerves appear.', points: ['Build fuller answers', 'Practise with AI voice feedback'] },
];
---

<BaseLayout title="IELTS is EZ | Your path to a stronger band" description="See how IELTS is EZ helps you learn, practise and improve across Reading, Listening, Writing and Speaking.">
  <div class="journey scroll-story" data-scroll-story>
    <section class="journey-hero" aria-labelledby="journey-title">
      <div class="journey-wrap hero-grid">
        <div class="hero-copy">
          <p class="journey-label">AI-powered IELTS preparation</p>
          <h1 id="journey-title">IELTS feels <span>EZ</span> when you know the <span>structure.</span></h1>
          <p class="journey-lede">Clear methods for all four skills, guided practice, and AI feedback that shows you what to improve.</p>
          <div class="hero-actions">
            <div class="band-choice">
              <p>Choose your target band</p>
              <span>Pick your goal. We’ll show you the way.</span>
              <div class="band-picker" role="group" aria-label="Choose your target IELTS band">{[6.5, 7, 7.5, 8, 8.5, 9].map((band) => <button type="button" data-band={band} aria-pressed={band === 7 ? 'true' : 'false'}>{band}</button>)}</div>
              <p class="band-feedback" data-band-feedback aria-live="polite">Band 7.0 selected</p>
            </div>
            <a class="journey-cta" href="#reading">Start your journey</a>
          </div>
        </div>
        <div class="hero-scene hero-skill-scene" data-skill-stack aria-label="How IELTS is EZ teaches each skill">
          <div class="hero-stack-backdrop" aria-hidden="true"><span>Learn</span><span>Practise</span><span>Improve</span></div>
          <div class="hero-skill-stack">
            {heroSkills.map((item, index) => (
              <article class="hero-skill-card" data-skill-card data-stack-position={index === 0 ? 'active' : index === 1 ? 'next' : index === 2 ? 'behind' : 'retiring'} data-active={index === 0 ? 'true' : 'false'} aria-hidden={index === 0 ? 'false' : 'true'}>
                <p>IELTS skill 0{index + 1}</p>
                <h2>{item.skill}</h2>
                <h3>{item.promise}</h3>
                <ul>{item.points.map((point) => <li>{point}</li>)}</ul>
              </article>
            ))}
          </div>
          <div class="hero-stack-controls">
            <div class="hero-stack-indicators" aria-label="Choose an IELTS skill card">{heroSkills.map((item, index) => <button type="button" data-stack-indicator={index} aria-label={`Show ${item.skill}`} aria-current={index === 0 ? 'true' : 'false'}><span></span></button>)}</div>
          </div>
        </div>
      </div>
    </section>

    <section class="ai-coach ai-coach-simple" aria-labelledby="ai-coach-title">
      <div class="journey-wrap ai-coach-grid">
        <div class="ai-coach-copy">
          <p class="journey-label">Your AI IELTS coach</p>
          <h2 id="ai-coach-title">Feedback you can use.</h2>
          <p>Write or speak, then see what is working, what is holding you back, and exactly what to improve next.</p>
          <p class="ai-trust-line">Developed by an IELTS teacher who completed IDP training in Writing and Speaking assessment criteria.</p>
          <ul class="ai-capabilities"><li><b>Four IELTS criteria</b><span>Estimated bands and focused comments</span></li><li><b>Real speaking feedback</b><span>Including pronunciation from your recording</span></li></ul>
        </div>
        <div class="ai-workspace" aria-label="Sample AI writing feedback">
          <div class="ai-workspace-bar"><span>Sample response</span><b>AI coach feedback</b></div>
          <div class="ai-response"><p>Universities should provide more study spaces because they are <mark>good for students</mark>.</p></div>
          <div class="ai-annotation"><span>Make the reason specific</span><p>Explain what students can do there and why it matters.</p></div>
          <div class="ai-improvement"><span>Stronger version</span><p>Quiet study spaces help students use gaps between classes for focused revision.</p></div>
          <a href={withBase('/trainers/writing')}>Try AI Writing feedback</a>
        </div>
      </div>
    </section>

    <section class="skills-story" aria-labelledby="skills-title">
      <div class="journey-wrap story-heading"><div><p class="journey-label">Inside the course</p><h2 id="skills-title">Four skills.<br />A clearer way forward.</h2></div><p class="story-target">Your target <strong data-target-label>7.0</strong></p></div>
      <svg class="story-road-svg" aria-hidden="true"><path class="story-road-edge" data-story-path d="M 50 0 L 50 100"/><path class="story-road-dash" data-story-path-copy d="M 50 0 L 50 100"/></svg>
      <div class="game-student story-traveller" data-story-traveller data-state="read" data-facing="right" data-path-position="0"><GameStudent /></div>
      {skills.map((item, index) => (
        <article class={`skill-story skill-story-${index + 1}`} id={item.skill.toLowerCase()} data-road-section data-skill-section data-skill-state={item.state}>
          <div class="journey-wrap skill-story-grid">
            <div class="skill-stop">
              <button type="button" data-story-stop aria-label={`Visit ${item.skill}`}><span>0{index + 1}</span><b>{item.skill}</b></button>
            </div>
            <div class="skill-copy">
              <p class="journey-label">Skill {index + 1} of 4</p>
              <h3>{item.skill}</h3>
              <h4>{item.title}</h4>
              <ul>{item.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
              <a href={item.link}>{item.label}</a>
            </div>
          </div>
        </article>
      ))}
      <article class="skill-story skill-story-5 journey-goal" id="target-band" data-road-section data-skill-state="celebrate">
        <div class="journey-wrap skill-story-grid">
          <div class="skill-stop"><button type="button" data-story-stop aria-label="Visit your target band"><span>★</span><b>Target</b></button></div>
          <div class="skill-copy goal-copy">
            <p class="journey-label">Your journey continues</p>
            <h3>Target <span data-target-label>7.0</span></h3>
            <h4>Your target. Your next chapter.</h4>
            <p>Build toward your target with a clear study plan, realistic practice, and feedback on your next step.</p>
            <a href={withBase('/dashboard')}>Explore the full course</a>
          </div>
        </div>
      </article>
    </section>
    <section class="final-course-cta" aria-labelledby="final-course-title">
      <div class="journey-wrap final-course-inner">
        <p class="journey-label">Ready when you are</p>
        <h2 id="final-course-title">Start your IELTS journey today.</h2>
        <p>Get a clear plan across all four skills, realistic practice, and feedback that shows you what to improve next.</p>
        <a href={withBase('/start')}>Build my study plan</a>
      </div>
    </section>
  </div>
</BaseLayout>
<script>import '../scripts/home-game';</script>
