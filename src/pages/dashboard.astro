---
import BaseLayout from '../layouts/BaseLayout.astro';
import LearningDashboard from '../components/LearningDashboard';
import AccessHome from '../components/trial/AccessHome';
import { ACCESS_MODE } from '../lib/trial/mode';

/* The gated build (PUBLIC_ACCESS_MODE=trial, the free-account model of
   1 October 2026): a free account's Today is its course and next lessons,
   with one calm card about practice and guidance; practice and guidance
   gets the personal Today (AccessHome switches on the account). The open
   site is unchanged. */
const trial = ACCESS_MODE === 'trial';
---
<BaseLayout wide title="Dashboard · IELTS is EZ" description="Your IELTS preparation dashboard.">
  {trial ? <AccessHome client:load page="dashboard" /> : <LearningDashboard client:load />}
</BaseLayout>

<style is:global>
  @import '../styles/platform-pages.css';
</style>
