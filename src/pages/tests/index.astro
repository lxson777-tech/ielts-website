---
import CatalogueControls from '../../components/CatalogueControls.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PracticeOrTest from '../../components/PracticeOrTest.astro';
import Count from '../../components/Count.astro';
import { ntn } from '../../lib/i18n/translate';
import TestsResults from '../../components/TestsResults';
import TestsHubCheckpoints from '../../components/learning/TestsHubCheckpoints';
import { withBase } from '../../lib/url';
import { ALL_TESTS } from '../../data/tests';
import { questionCount } from '../../lib/tests/schema';
import { ACCESS_MODE } from '../../lib/trial/mode';
import { nt } from '../../lib/i18n/translate';

/* The Tests page, simplified 8 October 2026 (Alex: "it feels
   overwhelming"). Five tiles to start something, one quiet line to the
   coached practice, one quiet line to an unseen checkpoint paper, the bank
   of every paper behind Reading / Listening tabs, the student's results
   behind the same tabs, and the small print at the bottom. Every
   destination the page had is still here; the warnings that used to sit
   under each button ("the clock cannot be paused", "use headphones",
   "microphone access required") are said on each test's own start screen,
   before its clock starts.

   The gated build (PUBLIC_ACCESS_MODE=trial, the free-account model of
   1 October 2026): every timed test, the Writing Checker, the live examiner
   and the trainers come with practice and guidance. The page reads the same
   for everyone; for an account without it, every start tile and every
   paper link opens the upgrade pop-up instead (src/lib/access/paid-guard.ts:
   the Reading and Listening tiles carry data-paid-feature, the other links
   point at paid pages). The open build renders exactly what it always did. */
const trialBuild = ACCESS_MODE === 'trial';
const historySubtitle = trialBuild
  ? nt('Your attempts are saved with your account, so you see them on any device you sign in on.')
  : nt('Attempts are stored in your browser, no account needed.');

/* One tile, a different exam every attempt: the cycle covers every test
   before any repeats. Only the ids ship to the client; the test content
   itself stays on the per-test pages. */
const readingTests = ALL_TESTS.filter((test) => test.skill === 'reading');
const listeningTests = ALL_TESTS.filter((test) => test.skill === 'listening');
const readingSample = readingTests[0];
const listeningSample = listeningTests[0];

const groups = [
  { key: 'reading', label: 'Reading', tests: readingTests },
  { key: 'listening', label: 'Listening', tests: listeningTests },
].filter((group) => group.tests.length > 0);
---

<BaseLayout
  title="Tests · IELTS Portal"
  description="Full timed IELTS tests under real exam conditions, with instant scoring and band estimates."
>
  <div class="tests-hub tests-hub-v3 mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <header class="tests-head">
      <h1 data-i18n>Tests</h1>
      <p>
        <span data-i18n>Timed, exactly like the real exam.</span>
        {/* The band guide's home since the account menu was shortened (1 October 2026). */}
        <a href={withBase('/learn/bands')} data-i18n>What each band needs</a>
      </p>
    </header>

    {/* Paper names (Reading, Listening, Writing, Speaking) are protected and
        stay English in every language, as everywhere else on the site. */}
    <div class="tests-tiles">
      {readingSample && (
        <button
          type="button"
          class="tests-tile skill-reading"
          data-test-rotation
          data-tile="reading"
          data-paid-feature={trialBuild ? 'test' : undefined}
          data-test-ids={JSON.stringify(readingTests.map((test) => test.id))}
          data-rotation-key="ielts.rotation.reading-tests.v1"
        >
          <span class="tests-tile-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z" /><path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z" /></svg>
          </span>
          <span class="tests-tile-name">Reading</span>
          <Count class="tests-tile-time" phrase={ntn(readingSample.durationMinutes, { one: '{n} min', other: '{n} min' })} />
          <span class="tests-tile-line" data-tile-line data-i18n>A new full paper every time.</span>
          <span class="tests-tile-last" data-last-band hidden></span>
        </button>
      )}
      {listeningSample && (
        <button
          type="button"
          class="tests-tile skill-listening"
          data-test-rotation
          data-tile="listening"
          data-paid-feature={trialBuild ? 'test' : undefined}
          data-test-ids={JSON.stringify(listeningTests.map((test) => test.id))}
          data-rotation-key="ielts.rotation.listening-tests.v1"
        >
          <span class="tests-tile-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3" /></svg>
          </span>
          <span class="tests-tile-name">Listening</span>
          <Count class="tests-tile-time" phrase={ntn(listeningSample.durationMinutes, { one: '{n} min', other: '{n} min' })} />
          <span class="tests-tile-line" data-tile-line data-i18n>Four parts, the recording plays once.</span>
          <span class="tests-tile-last" data-last-band hidden></span>
        </button>
      )}
      <a href={withBase('/writing/checker')} class="tests-tile skill-writing" data-tile="writing">
        <span class="tests-tile-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 20h9" /><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
        </span>
        <span class="tests-tile-name">Writing</span>
        <span class="tests-tile-time" data-i18n>20 or 40 min</span>
        <span class="tests-tile-line" data-i18n>Task 1 or Task 2, marked by AI.</span>
      </a>
      <a href={withBase('/speaking/examiner')} class="tests-tile skill-speaking" data-tile="speaking">
        <span class="tests-tile-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" /><path d="M19 10v2a7 7 0 0 1-14 0v-2" /><path d="M12 19v3" /></svg>
        </span>
        <span class="tests-tile-name">Speaking</span>
        <span class="tests-tile-time" data-i18n>11 to 14 min</span>
        <span class="tests-tile-line" data-i18n>A live interview with an AI examiner.</span>
      </a>
      <a href={withBase('/tests/mock')} class="tests-tile tests-tile-mock" data-tile="mock">
        <span class="tests-tile-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><rect width="18" height="17" x="3" y="5" rx="2" /><path d="M16 3v4M8 3v4M3 11h18" /><path d="m9 16 2 2 4-4" /></svg>
        </span>
        <span class="tests-tile-name" data-i18n>Mock Exam Day</span>
        <span class="tests-tile-time" data-i18n>About 3 hours</span>
        <span class="tests-tile-line" data-i18n>All four papers in one sitting.</span>
      </a>
    </div>

    <p class="tests-quiet-line">
      <span data-i18n>Short on time? Practise one part at a time.</span>
      <a href={withBase('/trainers')} data-i18n>Go to Practice</a>
    </p>

    {/* Its recommendations are papers from the whole bank, so the gated
        build shows them to practice and guidance only (src/lib/access/
        paid-guard.ts shows [data-access-copy="paid"]). */}
    {trialBuild ? (
      <div data-access-copy="paid" hidden>
        <TestsHubCheckpoints client:load />
      </div>
    ) : (
      <TestsHubCheckpoints client:load />
    )}

    <section data-discovery data-catalogue-limit="6" class="test-catalog tests-section" aria-labelledby="catalog-heading">
      <div class="tests-section-head">
        <h2 id="catalog-heading" data-i18n>Every full exam</h2>
        <div role="tablist" class="tests-tabs" data-catalog-tabs data-i18n-attr="aria-label" aria-label="Choose a paper">
          {groups.map((group, index) => (
            <button
              type="button"
              role="tab"
              id={`catalog-tab-${group.key}`}
              aria-controls={`catalog-panel-${group.key}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              data-catalog-tab={group.key}
              class="tests-tab"
            >
              <span>{group.label}</span>
              <span class="tests-tab-count" data-catalog-tab-count={group.key}>{group.tests.length}</span>
            </button>
          ))}
        </div>
      </div>
      <CatalogueControls />
      <div class="test-catalog-columns tests-catalog-panels">
        {groups.map((group, index) => (
          <div
            data-discovery-group={group.key}
            data-tab-group
            data-tab-inactive={index === 0 ? undefined : ''}
            hidden={index !== 0}
            role="tabpanel"
            id={`catalog-panel-${group.key}`}
            aria-labelledby={`catalog-tab-${group.key}`}
            class={`test-catalog-group skill-${group.key}`}
          >
            <ul>
              {group.tests.map((test, i) => (
                <li data-discovery-item data-search={group.label}><a href={withBase(`/tests/${test.id}`)} data-checkpoint-target={test.id}><span class="test-index">{String(i + 1).padStart(2, '0')}</span><span class="test-name">{test.title}</span><span class="test-meta"><Count phrase={test.id === 'listening-full-011' ? ntn(39, { one: '{n} scored question', other: '{n} scored questions' }) : ntn(questionCount(test), { one: '{n} question', other: '{n} questions' })} /></span></a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p data-catalogue-empty hidden class="discovery-empty" data-i18n>No matches. Try another search.</p>
      <button type="button" data-catalogue-more class="discovery-more" data-i18n>Show more</button>
    </section>

    <section id="results" class="tests-section scroll-mt-20" aria-labelledby="results-heading">
      {/* Old links to #history and #analytics land here too. */}
      <span id="history" class="tests-anchor" aria-hidden="true"></span>
      <span id="analytics" class="tests-anchor" aria-hidden="true"></span>
      <h2 id="results-heading" data-i18n>Your results</h2>
      <TestsResults client:load subtitle={historySubtitle} />
    </section>

    <footer class="tests-small-print">
      <PracticeOrTest current="tests" />
      {/* One sentence, translated whole. The source's name is a proper noun
          at the end, so no sentence is split around a link. */}
      {listeningTests.length > 0 && (
        <p class="tests-credits">
          <span data-i18n>Listening questions and recordings are adapted with permission from</span>{' '}
          <a href="https://practicepteonline.com/listening-ielts-tests/" target="_blank" rel="noreferrer">PracticePTEOnline</a>.
        </p>
      )}
    </footer>
  </div>
</BaseLayout>

<style is:global>
  @import '../../styles/platform-pages.css';
  @import '../../styles/tests-hub.css';
</style>

<script>
  import { withBase } from '../../lib/url';
  import { nextInRotation } from '../../lib/rotation';
  import { activeSession, secondsLeft } from '../../lib/test-session';
  import { t } from '../../lib/i18n/translate';
  import { onLocaleChange } from '../../lib/i18n/locale';
  import { getAttempts, onProgressChange } from '../../lib/progress';
  import { lastBands, type HubSkill } from '../../components/tests-hub';

  /* The Reading and Listening tiles. An unfinished attempt means the clock
     is still running, so the tile sends the student back to it instead of
     handing out a new exam, and its short line says so. */
  function initRotation() {
    document.querySelectorAll<HTMLButtonElement>('[data-test-rotation]:not([data-bound])').forEach((btn) => {
      btn.dataset.bound = 'true';
      const ids: string[] = JSON.parse(btn.dataset.testIds!);
      const rotationKey = btn.dataset.rotationKey!;
      const session = activeSession();
      const resume = session && ids.includes(session.testId) && secondsLeft(session) > 0 ? session : null;
      if (resume) {
        const line = btn.querySelector<HTMLElement>('[data-tile-line]');
        if (line) {
          /* Set through t() directly rather than data-i18n: this text is
             computed on the student's device, where the locale is known. */
          line.removeAttribute('data-i18n');
          line.dataset.resumeMin = String(Math.ceil(secondsLeft(resume) / 60));
          line.classList.add('is-resume');
        }
      }
      btn.addEventListener('click', () => {
        const id = resume ? resume.testId : nextInRotation(rotationKey, ids);
        window.location.href = withBase(`/tests/${id}`);
      });
    });
  }

  function paintResumeLines() {
    document.querySelectorAll<HTMLElement>('[data-tile-line][data-resume-min]').forEach((line) => {
      line.textContent = t('Resume your test: {min} min left', { min: Number(line.dataset.resumeMin) });
    });
  }

  /* "Last: Band 6.5" on the Reading and Listening tiles, from the same
     progress store the results below read. */
  function paintLastBands() {
    let bands: Partial<Record<HubSkill, string>> = {};
    try {
      bands = lastBands(getAttempts());
    } catch {
      bands = {};
    }
    document.querySelectorAll<HTMLElement>('[data-test-rotation][data-tile]').forEach((tile) => {
      const el = tile.querySelector<HTMLElement>('[data-last-band]');
      const band = bands[tile.dataset.tile as HubSkill];
      if (!el) return;
      el.hidden = !band;
      el.textContent = band ? t('Last: Band {band}', { band }) : '';
    });
  }

  /* The bank's Reading / Listening tabs (WAI-ARIA tabs: arrow keys, Home
     and End move between them). The lists themselves are filtered by
     CatalogueControls, which skips a group marked data-tab-inactive and
     reports how many matches each group holds. */
  function initCatalogTabs() {
    const root = document.querySelector<HTMLElement>('[data-discovery]');
    const list = root?.querySelector<HTMLElement>('[data-catalog-tabs]');
    if (!root || !list || list.dataset.bound) return;
    list.dataset.bound = 'true';
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[data-catalog-tab]')];
    const select = (key: string, focus: boolean) => {
      tabs.forEach((tab) => {
        const on = tab.dataset.catalogTab === key;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
        if (on && focus) tab.focus();
      });
      root.querySelectorAll<HTMLElement>('[data-discovery-group]').forEach((group) => {
        if (group.dataset.discoveryGroup === key) group.removeAttribute('data-tab-inactive');
        else group.setAttribute('data-tab-inactive', '');
      });
      root.dispatchEvent(new CustomEvent('discovery:refresh'));
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab.dataset.catalogTab!, false));
      tab.addEventListener('keydown', (e) => {
        let next: number | null = null;
        if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        if (next === null) return;
        e.preventDefault();
        select(tabs[next]!.dataset.catalogTab!, true);
      });
    });
    root.addEventListener('discovery:counts', (e) => {
      const counts = (e as CustomEvent<Record<string, number>>).detail ?? {};
      root.querySelectorAll<HTMLElement>('[data-catalog-tab-count]').forEach((el) => {
        el.textContent = String(counts[el.dataset.catalogTabCount!] ?? 0);
      });
    });
  }

  function init() {
    initRotation();
    initCatalogTabs();
    paintResumeLines();
    paintLastBands();
  }
  onProgressChange(paintLastBands);
  onLocaleChange(() => {
    paintResumeLines();
    paintLastBands();
  });
  document.addEventListener('astro:page-load', init);
  init();
</script>
