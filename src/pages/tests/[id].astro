---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GatedTestPlayer from '../../components/trial/GatedTestPlayer';
import { ACCESS_MODE } from '../../lib/trial/mode';
import TestPlayer from '../../components/TestPlayer';
import { withBase } from '../../lib/url';
import { ALL_TESTS } from '../../data/tests';

export function getStaticPaths() {
  return ALL_TESTS.map((test) => ({ params: { id: test.id }, props: { test } }));
}

const { test } = Astro.props;
/* A trial build puts only the paper's id and title on the page; the paper
   itself comes from the content gate (GatedTestPlayer). */
const gated = ACCESS_MODE === 'trial';
---

<BaseLayout title={`${test.title} · IELTS ${test.skill === 'reading' ? 'Reading' : 'Listening'} Test`} bare>
  <div class={`skill-${test.skill}`}>
    {gated ? (
      <GatedTestPlayer client:load testId={test.id} title={test.title} section={test.skill === 'listening' ? 'Listening' : 'Reading'} hubUrl={withBase('/tests')} />
    ) : (
      <TestPlayer client:load test={test} hubUrl={withBase('/tests')} />
    )}
  </div>
</BaseLayout>
