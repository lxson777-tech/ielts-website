---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MockExam from '../../components/MockExam';
import { withBase } from '../../lib/url';
import PaidContent from '../../components/trial/PaidContent';
import { ACCESS_MODE } from '../../lib/trial/mode';

/* The gated build (PUBLIC_ACCESS_MODE=trial) writes none of this page's
   material into it: a paid account's browser receives it through the content
   gate, and PaidContent mounts the tool once it is in. */
const gated = ACCESS_MODE === 'trial';
---

<BaseLayout
  title="Mock Exam Day · IELTS Portal"
  trialGate={{ kind: 'locked', title: 'Mock Exam Day', paidContent: true }}
  description="A full, chained IELTS sitting: Listening, then Reading, then Writing, then Speaking, with no breaks, the same order and pace as the real test day."
  bare
>
  {gated ? (
    <PaidContent client:load full view={{ name: 'mock-exam', hubUrl: withBase('/tests') }} />
  ) : (
    <MockExam client:load hubUrl={withBase('/tests')} />
  )}
</BaseLayout>
