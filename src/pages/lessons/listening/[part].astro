---
import LessonLayout from '../../../layouts/LessonLayout.astro';
import LessonStep from '../../../components/LessonStep.astro';
import PracticeQuiz from '../../../components/PracticeQuiz';
import { withBase } from '../../../lib/url';
import { LISTENING_PARTS } from '../../../data/listening';
import { LISTENING_PRACTICE } from '../../../data/listening-practice';

export function getStaticPaths() {
  return LISTENING_PARTS.map((part, i) => ({
    params: { part: part.slug },
    props: { part, order: i + 1, of: LISTENING_PARTS.length, prev: LISTENING_PARTS[i - 1] ?? null, next: LISTENING_PARTS[i + 1] ?? null },
  }));
}

const { part, order, of, prev, next } = Astro.props;

const fragments = import.meta.glob<string>('../../../content/lesson-bodies/listening-*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const raw = fragments[`../../../content/lesson-bodies/listening-${part.slug}.html`];
if (!raw) throw new Error(`Missing fragment for listening part: ${part.slug}`);
const body = raw.replaceAll('../pics/', withBase('/pics/'));

const overviewUrl = withBase('/lessons/listening');
const practice = LISTENING_PRACTICE[part.slug];
---

<LessonLayout
  slug={`listening-${part.slug}`}
  meta={{ title: part.title, description: part.blurb, skill: 'listening' }}
  parent={{ label: 'Listening', href: overviewUrl }}
>
  <LessonStep order={order} of={of} section="Listening" />

  <Fragment set:html={body} />

  {practice && (
    <div class="mt-10 text-center">
      <h2 class="font-display text-xl font-bold text-ink sm:text-2xl">Practice with real test questions</h2>
      <p class="mt-1 text-sm text-ink-muted">The recording and questions below come from a real IELTS Listening test.</p>
    </div>
  )}
  {practice && <PracticeQuiz client:load set={practice} />}

  <nav class="mt-12 grid gap-3 border-t border-border pt-6 sm:grid-cols-3" aria-label="Listening section">
    {
      prev ? (
        <a href={withBase(`/lessons/listening/${prev.slug}`)} class="group rounded-card border border-border p-4 transition-colors hover:border-[var(--skill)]">
          <span class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Previous</span>
          <span class="mt-1 block font-display text-sm font-bold group-hover:text-[var(--skill)]">{prev.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    <a href={overviewUrl} class="group rounded-card border border-border p-4 text-center transition-colors hover:border-[var(--skill)]">
      <span class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Listening</span>
      <span class="mt-1 block font-display text-sm font-bold group-hover:text-[var(--skill)]">All Listening Lessons</span>
    </a>
    {
      next ? (
        <a href={withBase(`/lessons/listening/${next.slug}`)} class="group rounded-card border border-border p-4 text-right transition-colors hover:border-[var(--skill)]">
          <span class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Next</span>
          <span class="mt-1 block font-display text-sm font-bold group-hover:text-[var(--skill)]">{next.title}</span>
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</LessonLayout>
