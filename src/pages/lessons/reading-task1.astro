---
import LessonLayout from '../../layouts/LessonLayout.astro';
import LessonTypeGrid from '../../components/LessonTypeGrid.astro';
import { withBase } from '../../lib/url';
import { publicLessonHtml } from '../../lib/access/public-lessons';
import { ACCESS_MODE } from '../../lib/trial/mode';
import { ALL_TESTS } from '../../data/tests';
import { questionCount } from '../../lib/tests/schema';
import Count from '../../components/Count.astro';
import { ntn } from '../../lib/i18n/translate';
import { READING_GROUPS, READING_PARTS } from '../../data/reading';
import raw from '../../content/lesson-bodies/reading-task1.html?raw';

const body = publicLessonHtml(raw.replaceAll('../pics/', withBase('/pics/')));
const readingTests = ALL_TESTS.filter((t) => t.skill === 'reading');
const sample = readingTests[0];

// The lesson-card grid is generated from READING_PARTS/READING_GROUPS rather
// than hand-written in the fragment, so the fragment carries a marker
// comment that gets split on and replaced with <LessonTypeGrid>.
const CARD_MARKER = '<!-- lesson-cards -->';
const markerIndex = body.indexOf(CARD_MARKER);
if (markerIndex === -1) throw new Error('reading-task1.html is missing the "<!-- lesson-cards -->" marker');
const bodyBeforeCards = body.slice(0, markerIndex);
const bodyAfterCards = body.slice(markerIndex + CARD_MARKER.length);
/* The gated build carries only the generated card grid (the free-account
   model): the lesson text around it comes through the content door. */
const gated = ACCESS_MODE === 'trial';

---

<LessonLayout slug="reading-task1">
  {/* One wrapper, not one per half: the marker sits inside an open
      <div class="section">, so the halves are not balanced HTML on their
      own. The grid is wrapped so a language swap can lift it out and put
      the same node back (see src/lib/i18n/lesson-body.ts). display:contents
      keeps it laid out as a direct child of the section, as before. */}
  {/* A trial build carries only the generated card grid; the lesson text
      around it comes from the content gate (src/lib/i18n/lesson-body.ts puts
      it round the same grid node, at the fragment's marker). */}
  <div data-lesson-body="reading-task1" data-lesson-gated={gated ? '' : undefined}>
    {!gated && <Fragment set:html={bodyBeforeCards} />}
    <div data-lesson-cards style="display:contents">
      <LessonTypeGrid groups={READING_GROUPS} parts={READING_PARTS} hrefBase="reading" />
    </div>
    {!gated && <Fragment set:html={bodyAfterCards} />}
  </div>

  <hr class="divider" />
  <div class="section" id="timed-test">
    <div class="section-header">
      <div class="section-num">T</div>
      <div class="section-title-block">
        <div class="tag" data-i18n>Practice Tests</div>
        <h2 data-i18n>Take a Timed Test</h2>
      </div>
    </div>
    <p style="font-size:0.95rem; color:var(--color-ink-muted); margin-bottom:0.75rem;" data-i18n>Ready to put it together? Every attempt is a real exam: 3 passages, 40 questions, 60 minutes, with instant scoring and an estimated band, and you get a different test each time. Once you start, the clock can’t be paused.</p>
    <a class="cta-card" href={withBase('/tests')}>
      <span class="cta-card-body">
        {/* Four counted phrases from live test data, each translated whole. */}
        <span class="sample-topic">
          <Count phrase={ntn(sample.parts.length, { one: '{n} passage', other: '{n} passages' })} /> · <Count phrase={ntn(questionCount(sample), { one: '{n} question', other: '{n} questions' })} /> · <Count phrase={ntn(sample.durationMinutes, { one: '{n} min', other: '{n} min' })} /> · <Count phrase={ntn(readingTests.length, { one: '{n} test in rotation', other: '{n} tests in rotation' })} />
        </span>
        <strong class="sample-title" data-i18n>Take a Reading Test</strong>
        <span class="sample-go" data-i18n>Start a test</span>
      </span>
      <img src={withBase('/pics/reading/start-test.png')} alt="Stopwatch at 60:00 beside a reading test booklet" data-i18n-attr="alt" loading="lazy" />
    </a>
    <p class="material-source">
      <span data-i18n>Your score history lives on the</span> <a href={withBase('/tests')} data-i18n>practice tests page</a>.
    </p>
  </div>
</LessonLayout>
