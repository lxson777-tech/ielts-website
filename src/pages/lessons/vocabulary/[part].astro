---
import LessonLayout from '../../../layouts/LessonLayout.astro';
import LessonBody from '../../../components/LessonBody.astro';
import LessonStep from '../../../components/LessonStep.astro';
import { withBase } from '../../../lib/url';
import { VOCABULARY_PARTS } from '../../../data/vocabulary';
import { vocabTopicArt } from '../../../data/vocab-topic-art';
import { vocabGameHref } from '../../../lib/vocab-home';

export function getStaticPaths() {
  return VOCABULARY_PARTS.map((part, i) => ({
    params: { part: part.slug },
    props: { part, order: i + 1, of: VOCABULARY_PARTS.length, prev: VOCABULARY_PARTS[i - 1] ?? null, next: VOCABULARY_PARTS[i + 1] ?? null },
  }));
}

const { part, order, of, prev, next } = Astro.props;

const fragments = import.meta.glob<string>('../../../content/lesson-bodies/vocabulary-*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const raw = fragments[`../../../content/lesson-bodies/vocabulary-${part.slug}.html`];
if (!raw) throw new Error(`Missing fragment for vocabulary topic: ${part.slug}`);
const body = raw.replaceAll('../pics/', withBase('/pics/'));

const overviewUrl = withBase('/lessons/vocabulary');

/* The topic's picture (src/data/vocab-topic-art.ts) at the top of the
   lesson, kept short so the teaching starts within the first screen, and
   the way into the three games with this topic's words. Outside the lesson
   body on purpose: the gated build sends the body through the content gate,
   but the picture and the games are free. */
const art = vocabTopicArt(part.slug);
const gamesHref = vocabGameHref('match', part.slug);
---

<LessonLayout
  slug={`vocabulary-${part.slug}`}
  meta={{ title: part.title, description: part.blurb, skill: 'vocabulary' }}
  parent={{ label: 'Vocabulary', href: overviewUrl }}
>
  <LessonStep order={order} of={of} section="Vocabulary" />

  <figure class="vh-lesson-art">
    <span class="vh-pic">
      {art && <img src={withBase(art.src)} alt={art.alt} width={art.width} height={art.height} decoding="async" fetchpriority="high" />}
    </span>
    <figcaption>
      <a class="vh-lesson-play" href={gamesHref}>
        <span data-i18n>Play games with these words</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </figcaption>
  </figure>

  <LessonBody slug={`vocabulary-${part.slug}`} html={body} />

  <nav class="mt-12 grid gap-3 border-t border-border pt-6 sm:grid-cols-3" aria-label="Vocabulary section" data-i18n-attr="aria-label">
    {
      prev ? (
        <a href={withBase(`/lessons/vocabulary/${prev.slug}`)} class="group rounded-card border border-border p-4 transition-colors hover:border-[var(--skill)]">
          <span class="text-xs font-semibold uppercase tracking-wide text-ink-muted" data-i18n>Previous</span>
          <span class="mt-1 block font-display text-sm font-bold group-hover:text-[var(--skill)]">{prev.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    <a href={overviewUrl} class="group rounded-card border border-border p-4 text-center transition-colors hover:border-[var(--skill)]">
      <span class="text-xs font-semibold uppercase tracking-wide text-ink-muted" data-i18n>Vocabulary</span>
      <span class="mt-1 block font-display text-sm font-bold group-hover:text-[var(--skill)]" data-i18n>All Topics & Quiz</span>
    </a>
    {
      next ? (
        <a href={withBase(`/lessons/vocabulary/${next.slug}`)} class="group rounded-card border border-border p-4 text-right transition-colors hover:border-[var(--skill)]">
          <span class="text-xs font-semibold uppercase tracking-wide text-ink-muted" data-i18n>Next</span>
          <span class="mt-1 block font-display text-sm font-bold group-hover:text-[var(--skill)]">{next.title}</span>
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</LessonLayout>

<style is:global>
  @import '../../../styles/vocab-home.css';
</style>
