   /forgot-password). Same one-panel frame as the other account pages. */
import BaseLayout from '../layouts/BaseLayout.astro';
import ResetPassword from '../components/ResetPassword';
---

<BaseLayout title="Reset Password · IELTS Portal" description="Set a new password for your IELTS Portal account." noindex>
