---
/* Ask for a password-reset link (24 September 2026). The link lands on
   /reset-password. */
import BaseLayout from '../layouts/BaseLayout.astro';
import ForgotPasswordForm from '../components/auth/ForgotPasswordForm';
---

<BaseLayout title="Forgot password · IELTS Portal" description="Reset the password of your IELTS is EZ account." noindex>
  <ForgotPasswordForm client:load />
</BaseLayout>

<style is:global>
  @import '../styles/auth.css';
</style>
