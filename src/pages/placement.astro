---
/* /placement: the one-sitting placement test (src/components/placement/
   Placement.tsx). The material is named in src/data/placement.ts and nowhere
   else; it is resolved here against the real data and handed to the island.
   Anything the data does not have arrives as null and the page says "not
   available" calmly instead of failing, which is what keeps it safe in the
   trial build, where the big data modules are swapped for empty stand-ins.

   `bare`: a sitting has no workspace chrome and no tutor panel, the same
   rule as the test player and Mock Exam Day. The placement test comes with a
   subscription, not the trial, so a trial build declares it locked. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Placement from '../components/placement/Placement';
import PaidContent from '../components/trial/PaidContent';
import { placementMaterial } from '../lib/placement/material';
import { isTrialBuild } from '../lib/trial/mode';

/* A gated build locks this page for everyone but a paid account, and props
   are written into the page itself, so it carries no placement material
   there (the leak audit checks this). A paid account's browser receives the
   same material through the content gate (the pack `placement`, built by
   tools/build-gated-content.mjs from src/lib/placement/material.ts), and
   PaidContent mounts the test once it is in. */
const gated = isTrialBuild();
const material = gated ? null : placementMaterial();
---

<BaseLayout
  title="Placement test · IELTS Portal"
  trialGate={{ kind: 'locked', title: 'Placement test', paidContent: true }}
  description="A 40-minute placement test across Listening, Reading, Writing and Speaking, taken once, so your study plan starts from where you really are."
  bare
>
  {material ? <Placement client:load material={material} /> : <PaidContent client:load full view={{ name: 'placement' }} />}
</BaseLayout>
