---
/* The Writing Checker: exam conditions. Same grading engine as the Writing
   Trainer, but no coach panel, no idea hints, no reroll — the question, the
   clock, and your answer. This is the writing counterpart to the full
   Reading test at /tests and the live mock interview at /speaking/examiner;
   /trainers/writing is the coached practice version.

   This route used to be a redirect to /trainers/writing, which meant the
   "checker" handed students the trainer's coaching aids — the one surface
   where the practice/exam split had collapsed. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import WritingTester from '../../components/WritingTester';
import WritingHistory from '../../components/WritingHistory';
import { withBase } from '../../lib/url';
import { nt } from '../../lib/i18n/translate';
import { ACCESS_MODE } from '../../lib/trial/mode';
import { TRIAL_OFFER } from '../../lib/trial/offer';
import PaidContent from '../../components/trial/PaidContent';

/* The gated build: an account holds every essay, and the Writing Trainer
   is not part of the trial, so neither is offered in words (audit F03). */
const trialBuild = ACCESS_MODE === 'trial';
const introSubtitle = trialBuild
  ? nt('Exam conditions: you get a task and a clock, nothing else. Write your answer and an AI examiner grades it against the four official IELTS Writing criteria.')
  : nt('Exam conditions: you get a task and a clock, nothing else. Write your answer and an AI examiner grades it against the four official IELTS Writing criteria. Want structures, phrases and vocabulary while you write? Use the Writing Trainer instead.');
const historySubtitle = trialBuild
  ? nt('Saved with your account, so you see them on any device you sign in on.')
  : nt('Saved on this device, no account needed.');
---

<BaseLayout
  title="Writing Checker · IELTS Portal"
  trialGate={{ kind: 'locked', title: 'Writing Checker', paidContent: true, feature: 'essay' }}
  description="Write a Task 1 or Task 2 answer under exam conditions and get an AI-graded band report against the four official IELTS Writing criteria."
>
  <div class="skill-writing mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <SectionHeading
      eyebrow="Writing"
      title="Writing Checker"
      subtitle={introSubtitle}
    />
    {/* The gated build: essay feedback comes with practice and guidance; its
        questions arrive through the content gate (PaidContent). */}
    {trialBuild ? <PaidContent client:load view={{ name: 'writing-checker' }} /> : <WritingTester client:load variant="checker" />}

    <p class="mt-6 text-center text-sm">
      {trialBuild ? (
        <a href={withBase(TRIAL_OFFER.writing.lessonHref)} class="font-semibold text-brand hover:underline" data-i18n>
          Still learning the format? Read how to answer Task 2 first
        </a>
      ) : (
        <a href={withBase('/trainers/writing')} class="font-semibold text-brand hover:underline" data-i18n>
          Still learning the format? Practice with the coached Writing Trainer
        </a>
      )}
    </p>

    <section id="history" class="mt-16 scroll-mt-20">
      <SectionHeading title="Your past essays" subtitle={historySubtitle} />
      <WritingHistory client:load />
    </section>
  </div>
</BaseLayout>

<style is:global>
  @import '../../styles/platform-pages.css';
</style>
