---
/* Help: how the platform works, in the student's terms.
   Platform audit 2026-09-23: "Help" in the workspace footer pointed at the
   site root, which redirects to Today, so help sent students back where they
   started. Every answer here describes behaviour the site actually has (each
   is noted with where it lives), so it can be checked rather than trusted.
   "Talk to a person" (Builder E, 29 September 2026, audit F04): the
   support form (/support), which needs no published contact; Alex reads
   the messages in /admin. A direct contact appears beside it only once
   Alex publishes one in src/lib/operator.ts.
   Free and paid (Builder W, 1 October 2026): in the gated build every
   lesson is free with an account and practice and guidance are paid
   (docs/paid-access/FREE-ACCOUNT-MODEL.md), so two answers say how that
   works and how to get guidance, and Mr EZ's answer says he comes with it.
   The open build (today's live site) sells nothing and keeps its answers.
   Refunds (Builder L, 2 October 2026): "payments are not refunded after
   purchase" became the refund rule of the public offer
   (src/lib/legal/refund.ts, /terms#refunds), with its own answer here. The
   seller's email (src/lib/operator.ts, through sellerEmail()) joins "Talk
   to a person" on the gated build, as a marked placeholder until Alex fills
   it in, and on the open build only once it is filled in.
   Presentation is Codex's; this uses the existing account/report page shell. */
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
import { nt } from '../lib/i18n/translate';
import { publishedOperator } from '../lib/operator';
import { SUPPORT_ENABLED } from '../lib/support';
import { isTrialBuild } from '../lib/trial/mode';
import { PURCHASE_ENABLED } from '../components/access/payments';
import { sellerEmail } from '../lib/legal/offer';
import '../styles/legal.css';

const operator = publishedOperator();
const sellsAccess = isTrialBuild();
/* A direct way to write: the published operator contact, or else the
   seller's email from the legal details. */
const directEmail = operator?.contact ? null : sellerEmail(sellsAccess);

/* Gated build only: what is free, what is paid, and how to get guidance. */
const accessSections: { id: string; question: string; answers: string[] }[] = [
  {
    id: 'free-paid',
    question: nt('What is free, and what is paid?'),
    answers: [
      /* The access tiers: src/lib/access/model.ts. */
      nt('Every lesson is free with an account: the explanations, worked examples, each lesson’s own short quiz and the vocabulary lists.'),
      nt('Practice and guidance are paid: practice exercises and timed tests with band estimates, AI feedback on essays and recorded Speaking, live interviews with the AI examiner, full mock exams, the placement test, Mr EZ and the practice in your personal study plan.'),
      /* src/lib/access/plans.ts: 30 days, no renewal. */
      nt('Practice and guidance last 30 days and then simply end. Nothing renews. The Plans page shows the price and what 30 days include.'),
    ],
  },
  {
    id: 'refund',
    question: nt('Can I get a refund?'),
    answers: [
      /* The refund rule: src/lib/legal/refund.ts and the offer, /terms#refunds. */
      nt('Yes. You can ask for a refund at any time during the 30 days, and we pay back the share you have not used. The used share is the larger of the days that have started and the AI assessments you have used.'),
      nt('Ask through the support form, choosing a refund, or by email to the seller. The public offer has the full rule and a worked example.'),
    ],
  },
  {
    id: 'guidance',
    question: nt('How do I get practice and guidance?'),
    answers: PURCHASE_ENABLED
      ? [
          /* /plans: sign in, pay once; access starts when the payment is confirmed. */
          nt('Open the Plans page, sign in and pay once for 30 days. Your access starts as soon as the payment is confirmed, and your Account page shows when it ends.'),
          nt('When you reach for something that comes with practice and guidance, the platform tells you what it adds and links to the Plans page. Your lessons stay open either way.'),
        ]
      : [
          nt('Buying practice and guidance is not open yet. The Plans page shows the price and what 30 days include.'),
          nt('When you reach for something that comes with practice and guidance, the platform tells you what it adds and links to the Plans page. Your lessons stay open either way.'),
        ],
  },
];

const sections: { id: string; question: string; answers: string[] }[] = [
  ...(sellsAccess ? accessSections : []),
  {
    id: 'start',
    question: nt('Where do I start?'),
    answers: [
      /* TodaySession: one current session with one main action. */
      nt('Today shows one next step, with the reason it was chosen and about how long it takes. Press its main button and the platform takes you to the right lesson or practice.'),
      /* Course (/start): the rolling week from the same plan. */
      nt('Course shows the rest of your week. Only today is fixed; later days adjust as you finish work.'),
      /* /learn */
      nt('The lesson library lists every lesson if you want to choose for yourself.'),
    ],
  },
  {
    id: 'modes',
    question: nt('What is the difference between a lesson, practice and a test?'),
    answers: [
      nt('A lesson explains a question type or skill, with examples and short checks.'),
      /* Drills: replay allowed, answer notes, Mr EZ available afterwards. */
      nt('Practice is one passage or one recording. In Listening practice you can pause and replay the recording.'),
      /* TestPlayer full paper; mock exam. */
      nt('A test is a full paper under exam conditions: a clock that cannot be paused, a Listening recording that plays once, and no tutor help until you submit.'),
    ],
  },
  {
    id: 'timer',
    question: nt('What happens if I refresh or close the page during a test?'),
    answers: [
      /* TestPlayer instructions and test-session store. */
      nt('Your answers are kept and the clock keeps running, so you come back with the time already used. The paper hands itself in when time runs out.'),
      nt('In a full Listening paper, refreshing restarts the recording from the beginning.'),
    ],
  },
  {
    id: 'scores',
    question: nt('Is my score an official IELTS band?'),
    answers: [
      /* bandEstimate; drills show no band (TestPlayer score modal). */
      nt('No. A full practice paper gives an estimated band from the number of correct answers. A single practice passage or recording is too short for a band, so it shows your score only.'),
      /* grade-essay / grade-speaking Workers use the public descriptors. */
      nt('Writing and Speaking feedback is an AI estimate against the public IELTS band descriptors, not an official result.'),
    ],
  },
  {
    id: 'saving',
    question: nt('Where is my progress saved?'),
    answers: [
      /* store-owner: local, owner-scoped; auth/sync. */
      nt('On this device, in your browser. Sign in to keep it on your account and see it on your other devices.'),
      /* Owner-scoped stores: another student's work is never shown to you. */
      nt('If several people use one computer, each signed-in student sees only their own work.'),
    ],
  },
  {
    id: 'mr-ez',
    question: nt('What can Mr EZ do?'),
    answers: [
      /* MrEzPanel: sign-in required; reads only the student's own record.
         Gated build: he comes with practice and guidance (PaidFeature 'tutor'). */
      sellsAccess
        ? nt('Mr EZ is your AI tutor, and he comes with practice and guidance. He explains results, suggests what to practise next and answers questions about your own work, reading only your own results.')
        : nt('Mr EZ is your AI tutor. He explains results, suggests what to practise next and answers questions about your own work. He needs you to be signed in, because he only ever reads your own results.'),
      /* HELP_BLOCKED_MODES */
      nt('He does not help during a timed test. Once you submit, he can go through your mistakes with you.'),
    ],
  },
  {
    id: 'language',
    question: nt('Can I use the platform in Russian or Kazakh?'),
    answers: [
      /* i18n: interface and explanations; exam material stays English. */
      nt('Yes. Choose EN, RU or KZ at the top of the page. In Russian the interface and the explanations change language; in Kazakh the prices, the agreement, the privacy notice and the buying pages are in Kazakh and the rest is in Russian. Passages, recordings, questions and model answers stay in English, as in the real exam.'),
    ],
  },
];
---

<BaseLayout title="Help · IELTS is EZ" description="How the IELTS is EZ platform works: where to start, tests and timers, scores, saving progress and Mr EZ.">
  <div class="platform-hub mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <header class="mb-10 border-b border-border pb-8">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl" data-i18n>How the platform works</h1>
      {sellsAccess
        ? <p class="mt-3 max-w-2xl text-ink-muted" data-i18n>Short answers about free lessons, practice and guidance, tests, scores, saving your work and Mr EZ.</p>
        : <p class="mt-3 max-w-2xl text-ink-muted" data-i18n>Short answers about lessons, tests, scores, saving your work and Mr EZ.</p>}
    </header>

    <section class="help-person" aria-labelledby="help-person-title">
      <div>
        <h2 id="help-person-title" data-i18n>Talk to a person</h2>
        <p data-i18n>Something not working, or a question these answers do not cover? Write to us. A person reads every message and replies by email.</p>
        {operator?.contact && (
          <p>
            <span data-i18n>Or write directly:</span>{' '}
            {operator.contactHref ? <a href={operator.contactHref}>{operator.contact}</a> : operator.contact}
          </p>
        )}
        {directEmail && (
          <p>
            <span data-i18n>Or write directly:</span>{' '}
            {directEmail.draft ? <span class="legal-draft">{directEmail.text}</span> : <a href={directEmail.href ?? undefined}>{directEmail.text}</a>}
          </p>
        )}
      </div>
      {SUPPORT_ENABLED && <a class="policy-action" href={withBase('/support?reason=help')} data-i18n>Ask a person</a>}
    </section>

    <div class="space-y-3">
      {sections.map((section) => (
        <details id={section.id} class="support-disclosure">
          <summary data-i18n>{section.question}</summary>
          {section.answers.map((answer) => (
            <p class="mt-3 max-w-2xl text-ink" data-i18n>{answer}</p>
          ))}
        </details>
      ))}
    </div>

    <p class="mt-12 border-t border-border pt-8">
      <a href={withBase('/dashboard')} class="font-semibold text-brand hover:underline" data-i18n>Go to today's session</a>
    </p>
    <p class="help-policies">
      <a href={withBase('/privacy')} data-i18n>Privacy</a>
      {sellsAccess ? <a href={withBase('/terms')} data-i18n>Public offer</a> : <a href={withBase('/terms')} data-i18n>Terms of use</a>}
    </p>
  </div>
</BaseLayout>

<style is:global>
  @import '../styles/platform-pages.css';
  @import '../styles/trust-pages.css';
</style>
