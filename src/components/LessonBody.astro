---
/**
 * One lesson's migrated teaching HTML, wrapped in a marker the language
 * switch can find.
 *
 * The English fragment is baked in at build time exactly as before; the
 * wrapper only gives src/lib/i18n/lesson-body.ts something to replace when
 * a student reads in Russian. The div is a plain block with no styles of
 * its own, and every rule in src/styles/lesson.css is a descendant
 * selector under .lesson-body, so it changes nothing visually.
 *
 * Two lessons (listening.astro, reading-task1.astro) have a generated card
 * grid in the middle of their fragment. They do NOT use this component:
 * the cut falls inside an open section, so they write one data-lesson-body
 * wrapper around both halves and the grid by hand. See LESSON_CARDS_ATTR in
 * src/lib/i18n/lesson-body.ts for why.
 */
interface Props {
  /** The lesson's progress key, e.g. "reading-tfng" — also the name of the
      translated file under src/content/lesson-bodies/ru/. */
  slug: string;
  /** The fragment HTML, already passed through the ../pics/ rewrite. */
  html: string;
}
import { publicLessonHtml } from '../lib/access/public-lessons';
import { ACCESS_MODE } from '../lib/trial/mode';
const { slug, html } = Astro.props;
/* The gated build (the free-account model, 1 October 2026) carries no lesson
   text in the page: the wrapper is left empty and src/lib/i18n/lesson-body.ts
   fills it through the content door (workers/content-gate) for any signed-in
   account. The open site keeps the text inline, exactly as before. */
const gated = ACCESS_MODE === 'trial';
---

{gated ? <div data-lesson-body={slug} data-lesson-gated /> : <div data-lesson-body={slug} set:html={publicLessonHtml(html)} />}
