---
import { withBase } from '../lib/url';
import { PLATFORM_NAV_ITEMS, isPlatformNavActive } from '../lib/platform-nav';
const current = Astro.url.pathname;
const items = PLATFORM_NAV_ITEMS;
const isActive = (href: string) => isPlatformNavActive(href, current, withBase);
const paths: Record<string, string> = {
  home: '<path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v10h13V10M9 20v-6h6v6"/>', course: '<path d="M5 4.5h10.5A2.5 2.5 0 0 1 18 7v12H7a2 2 0 0 1-2-2V4.5Z"/><path d="M7 15h11M9 8h5"/>',
  book: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11v16H6.5A2.5 2.5 0 0 0 4 21V5.5Z"/><path d="M20 5.5A2.5 2.5 0 0 0 17.5 3H13v16h4.5A2.5 2.5 0 0 1 20 21V5.5Z"/>', target: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><path d="m14 10 6-6"/>',
  cards: '<rect x="3" y="8" width="13" height="10" rx="2"/><path d="M8 5.5A2 2 0 0 1 10 4h9a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-1"/>',
  check: '<path d="M6 3h12v18H6z"/><path d="m9 9 2 2 4-4M9 15h6"/>', voice: '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3"/>', user: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
};
---
<aside class="platform-rail" aria-label="Workspace navigation">
  <p class="platform-rail-label">Your study space</p>
  <nav class="platform-rail-nav">
    {items.map((item) => <a href={withBase(item.href)} class:list={['platform-rail-link', { 'is-active': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={paths[item.icon]} /></svg><span>{item.label}</span></a>)}
  </nav>
  <div class="platform-rail-note"><span aria-hidden="true">↗</span><p><strong>Keep going.</strong><br />A little practice each day adds up.</p></div>
</aside>
