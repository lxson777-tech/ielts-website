---
import { signUpHref } from '../../lib/auth/profile';
import { sales, type SalesKey } from '../../marketing/sales-copy';
/* The four questions. Their wording lives in src/marketing/sales-copy.ts
   (journey.q.<id>, journey.n.<id>, journey.o.<id>.<value>,
   journey.d.<id>.<value>), in English and Russian; the values are what the
   platform reads back after sign-up (journeyQuery in src/lib/journey-plan.ts),
   so they never change with the language. */
const questions = [
 {id:'band', options:['7','7.5','8']},
 {id:'skill', options:['speaking','writing','reading','listening']},
 {id:'focus', options:['method','confidence']},
 {id:'time', options:['15','30','60']},
];
const k = (key: string) => key as SalesKey;
---
<section id="the-approach" class="question-journey" aria-labelledby="journey-title" data-question-journey>
 <div class="journey-atmosphere" aria-hidden="true"><canvas class="journey-shader"></canvas></div>
 <div class="content-wrap journey-intro" id="your-plan"><p class="section-note" data-sales="journey.note">{sales('journey.note')}</p><h2 id="journey-title" data-sales="journey.title" set:html={sales('journey.title')} /><p data-sales="journey.lead">{sales('journey.lead')}</p><a class="journey-skip" href="#your-classroom" data-sales="journey.skip">{sales('journey.skip')}</a></div>
 {/* Without JavaScript nothing can translate this line either, so it stays English. */}
 <noscript><p class="content-wrap" lang="en">Enable JavaScript to build your suggested plan, or <a href="#pricing">see what is free and what is paid</a>.</p></noscript>
 <div class="content-wrap journey-layout" data-journey-interactive hidden>
  <div class="journey-answer-trail" aria-label={sales('journey.answers')} data-sales-attr="aria-label:journey.answers">{questions.map((q,i)=><button type="button" data-edit-step={i} hidden><span data-sales={k(`journey.chip.${q.id}`)}>{sales(k(`journey.chip.${q.id}`))}</span><b data-answer-chip={q.id}></b></button>)}</div>

  <form class="journey-questions" onsubmit="return false">
   {questions.map((q)=><fieldset class="journey-step" id={`journey-${q.id}`} data-question={q.id}>
    <legend><span class="section-note" data-sales={k(`journey.step.${q.id}`)}>{sales(k(`journey.step.${q.id}`))}</span><span class="journey-question-title" tabindex="-1" data-sales={k(`journey.q.${q.id}`)}>{sales(k(`journey.q.${q.id}`))}</span></legend>
    <p class="journey-note" data-sales={k(`journey.n.${q.id}`)}>{sales(k(`journey.n.${q.id}`))}</p>
    <div class={`journey-options ${q.id==='skill'?'journey-options-grid':''}`}>{q.options.map((value)=><label class="journey-option"><input type="radio" name={q.id} value={value}/><span><b data-sales={k(`journey.o.${q.id}.${value}`)}>{sales(k(`journey.o.${q.id}.${value}`))}</b><small data-sales={k(`journey.d.${q.id}.${value}`)}>{sales(k(`journey.d.${q.id}.${value}`))}</small></span><span class="journey-check" aria-hidden="true"></span></label>)}</div>
   </fieldset>)}
  </form>
 </div>
 <div class="content-wrap journey-result-wrap" data-journey-interactive hidden>
  <section id="journey-result" class="journey-result" aria-labelledby="journey-result-title" tabindex="-1">
   <div class="journey-result-intro"><p class="section-note" data-sales="journey.result.note">{sales('journey.result.note')}</p><h2 id="journey-result-title">{sales('journey.result.title')}</h2><p data-result-description aria-live="polite">{sales('journey.result.lead')}</p></div>
   <div class="journey-plan" data-plan-card hidden>
    <div class="journey-plan-summary"><span data-plan-label></span></div>
    {/* Two free lessons from the hardest section, each with what it helps with (1 October 2026). */}
    <ol class="journey-lessons" data-plan-lessons></ol>
    <div class="journey-plan-action"><div><h3 data-sales="journey.action.title">{sales('journey.action.title')}</h3><p data-sales="journey.action.text">{sales('journey.action.text')}</p></div><a class="button" data-plan-link data-signup-link href={signUpHref()} data-sales="nav.signUp">{sales('nav.signUp')}</a></div>
    <small data-sales="journey.disclaimer">{sales('journey.disclaimer')}</small>
   </div>
   <div class="journey-plan-placeholder" data-plan-placeholder><p data-sales="journey.placeholder">{sales('journey.placeholder')}</p><a href="#journey-band" data-plan-complete data-sales="journey.placeholder.cta">{sales('journey.placeholder.cta')}</a></div>
  </section>
 </div>
</section>
<script>import '../../scripts/question-journey';</script>
<style is:global>@import '../../styles/question-journey.css';</style>
