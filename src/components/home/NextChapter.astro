---
import { withBase } from '../../lib/url';
import QuestionJourney from './QuestionJourney.astro';
import SalesDemo from './SalesDemo.astro';
import PricingPlans from './PricingPlans.astro';
import { signInHref, signUpHref } from '../../lib/auth/profile';
import { sales, type SalesKey } from '../../marketing/sales-copy';
/* Every way in goes to the real platform (Alex, 1 October 2026: every lesson
   is free with an account, practice and guidance are paid, no trial):
   "Create a free account" to the sign-up page (which carries the
   questionnaire's answers once they are chosen, see question-journey.ts),
   "Sign in", or "Get practice and guidance" to the plans page. Lesson
   pages are not linked from here: a signed-out visitor would only meet the
   invitation to sign up. Prices come from the one approved source (via
   src/marketing/sales-copy.ts) so this page and /plans cannot disagree.

   Every sentence lives in src/marketing/sales-copy.ts, in English and
   Russian. Here the English is rendered; data-sales / data-sales-attr let
   src/marketing/sales-i18n.ts swap in the visitor's language. */
const signUp = signUpHref();
const signIn = signInHref();
const asset = (name: string) => withBase(`/pics/next-chapter/${name}`);
const skills = [
  { id: 'reading', name: 'Reading', number: '01' },
  { id: 'listening', name: 'Listening', number: '02' },
  { id: 'writing', name: 'Writing', number: '03' },
  { id: 'speaking', name: 'Speaking', number: '04' },
];
const methodKeys = (id: string) => (['m1', 'm2', 'm3'] as const).map((m) => `skill.${id}.${m}` as SalesKey);
const faqs = ['free', 'paid', 'cost', 'renewal', 'refund', 'unlimited', 'account', 'academic', 'official', 'exam', 'phone', 'speed'];
const k = (key: string) => key as SalesKey;
---
<aside class="sales-review-note" data-sales="review.note">{sales('review.note')}</aside>
<div class="sales-nav-anchor"><header class="story-nav" data-story-nav>
  <a class="wordmark" href="#main" aria-label={sales('nav.home')} data-sales-attr="aria-label:nav.home">IELTS<span>is</span><b>EZ</b></a>
  <nav class="chapter-nav" aria-label={sales('nav.main')} data-sales-attr="aria-label:nav.main" id="chapter-nav">
    <a href="#meet-mr-ez" data-sales="nav.tutor">{sales('nav.tutor')}</a>
    <a href="#feedback" data-sales="nav.feedback">{sales('nav.feedback')}</a>
    <a href="#your-plan" data-sales="nav.plan">{sales('nav.plan')}</a><a href="#pricing" data-sales="nav.pricing">{sales('nav.pricing')}</a>
    <a class="menu-sign-in" href={signIn} data-sales="nav.signIn">{sales('nav.signIn')}</a>
  </nav>
  <div class="nav-actions">
    {/* The language switch. Each language is named in its own language and
        never translated; the choice is the workspace's stored choice. */}
    <div class="lang-switch" role="group" aria-label={sales('lang.group')} data-sales-attr="aria-label:lang.group">
      <button type="button" lang="en" title="English" data-lang-option="en" aria-pressed="true">EN</button>
      <button type="button" lang="ru" title="Русский" data-lang-option="ru" aria-pressed="false">RU</button>
    </div>
    <a class="workspace-link" href={signIn} data-sales="nav.signIn">{sales('nav.signIn')}</a><a class="button button-small" href={signUp} data-signup-link><span class="cta-long" data-sales="nav.signUp">{sales('nav.signUp')}</span><span class="cta-short" data-sales="nav.signUpShort">{sales('nav.signUpShort')}</span></a><button class="menu-toggle" aria-label={sales('nav.menuOpen')} data-sales-attr="aria-label:nav.menuOpen" aria-controls="chapter-nav" aria-expanded="false"><span></span><span></span></button></div>
</header></div>
<main id="main" data-next-chapter>
  <section class="campus-story" aria-labelledby="hero-title" data-campus-scene data-sc-act="flow">
    <div class="campus-stage" data-sc-stage data-sc-verify-state="opening">
      <div class="campus-atmosphere"><picture><source media="(max-width:1050px)" srcset={asset('university-campus-mobile.jpg')} /><img class="campus-back" src={asset('university-campus.jpg')} width="1536" height="1024" alt="" fetchpriority="high" data-campus-back /></picture><video class="campus-motion" data-campus-life data-src={asset('campus-life-loop.mp4')} muted playsinline loop preload="none" aria-hidden="true" tabindex="-1"></video></div>
      <div class="hero-copy" data-hero-copy>
        <p class="hero-product-label" data-sales="hero.label">{sales('hero.label')}</p>
        <h1 id="hero-title" data-sc-copy data-sales="hero.title" set:html={sales('hero.title')} />
      </div>
      <div class="platform-window hero-window" data-hero-window>
        <div class="window-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span data-sales="hero.bar" set:html={sales('hero.bar')} /><span class="preview-tag" data-sales="hero.preview">{sales('hero.preview')}</span></div>
        <img src={asset('platform-learn.jpg')} width="1264" height="760" alt={sales('hero.alt')} data-sales-attr="alt:hero.alt" fetchpriority="high" />
        <span class="window-open" data-sales="hero.open">{sales('hero.open')}</span>
      </div>
      <div class="university-gates" data-campus-front aria-hidden="true">
        <div class="gate-leaf gate-left"><img src={asset('university-gates.webp')} width="1536" height="1024" alt="" /></div>
        <div class="gate-leaf gate-right"><img src={asset('university-gates.webp')} width="1536" height="1024" alt="" /></div>
      </div>
      <div class="scene-baseline" aria-hidden="true"></div>
    </div>
  </section>

  <SalesDemo />

  <QuestionJourney />

  <section class="mr-ez-intro section-pad" id="meet-mr-ez" aria-labelledby="mr-ez-title">
    <div class="content-wrap mr-ez-grid">
      <div class="mr-ez-portrait">
        <div class="mr-ez-art"><img src={asset('mr-ez-approved.png')} width="1024" height="1536" loading="lazy" alt={sales('ez.alt')} data-sales-attr="alt:ez.alt" /></div>
        <div class="mr-ez-name"><span class="mr-ez-status" aria-hidden="true"></span><span data-sales="ez.name" set:html={sales('ez.name')} /></div>
      </div>
      <div class="mr-ez-copy">
        <p class="section-note" data-sales="ez.note">{sales('ez.note')}</p>
        <h2 id="mr-ez-title" data-sales="ez.title" set:html={sales('ez.title')} />
        <p class="mr-ez-lead" data-sales="ez.lead">{sales('ez.lead')}</p>
        <div class="tutor-example" aria-label={sales('ez.example')} data-sales-attr="aria-label:ez.example">
          <p class="tutor-example-label" data-sales="ez.example.label">{sales('ez.example.label')}</p>
          <p class="tutor-student" data-sales="ez.student" set:html={sales('ez.student')} />
          <div class="tutor-reply"><b>Mr EZ</b><p data-sales="ez.reply" set:html={sales('ez.reply')} /><p class="tutor-next" data-sales="ez.next">{sales('ez.next')}</p></div>
          <small data-sales="ez.disclaimer">{sales('ez.disclaimer')}</small>
        </div>
        <small class="mr-ez-access" data-sales="ez.access">{sales('ez.access')}</small>
      </div>
    </div>
  </section>

  <section id="your-classroom" class="classroom section-pad" data-sc-act="flow">
    <div class="content-wrap">
      <div class="section-heading"><div><p class="section-note" data-sales="room.note">{sales('room.note')}</p><h2 data-sc-copy data-sales="room.title" set:html={sales('room.title')} /></div><p data-sales="room.lead" set:html={sales('room.lead')} /></div>
      <div class="skill-accordion" aria-label={sales('room.choose')} data-sales-attr="aria-label:room.choose"><div class="skill-tabs" role="tablist" aria-label={sales('room.tabs')} data-sales-attr="aria-label:room.tabs">{skills.map((skill,index) => <button type="button" id={`tab-${skill.id}`} role="tab" aria-label={skill.name} aria-selected={index===0?'true':'false'} aria-controls={`panel-${skill.id}`} tabindex={index===0?0:-1} data-skill-tab={skill.id} data-position={index===3?-1:index}><span class="skill-card-top"><span aria-hidden="true">{skill.number}</span><span>{skill.name}</span></span><span class="skill-method" aria-hidden="true"><span class="skill-method-label" data-sales="room.method">{sales('room.method')}</span>{methodKeys(skill.id).map((key,i)=><span class="skill-method-step"><span>0{i+1}</span><span data-sales={key}>{sales(key)}</span></span>)}</span></button>)}</div></div>
      <p class="skill-orbit-hint" data-sales="room.hint">{sales('room.hint')}</p>
      <div class="skill-panels">{skills.map((skill,index) => <article class="skill-panel" id={`panel-${skill.id}`} role="tabpanel" aria-labelledby={`tab-${skill.id}`} hidden={index!==0} tabindex="0">
        <div class="skill-detail"><h3 data-sales={k(`skill.${skill.id}.headline`)}>{sales(k(`skill.${skill.id}.headline`))}</h3><p data-sales={k(`skill.${skill.id}.text`)}>{sales(k(`skill.${skill.id}.text`))}</p><ol class="mobile-skill-method">{methodKeys(skill.id).map(key=><li data-sales={key}>{sales(key)}</li>)}</ol></div>

      </article>)}</div>
      <div class="classroom-foot"><span data-sales="room.foot">{sales('room.foot')}</span></div>
    </div>
  </section>

  <section class="feedback section-pad" id="feedback" data-sc-act="flow">
    <div class="content-wrap feedback-grid">
      <div class="feedback-art" aria-label={sales('fb.art')} data-sales-attr="aria-label:fb.art">
        {/* The essay sentence and the redraft are English on purpose: they are
            the English a student is meant to learn from. */}
        <div class="essay-paper"><div class="paper-top"><span data-sales="fb.progress">{sales('fb.progress')}</span><span>Writing · Task 2</span></div><p lang="en">“Universities should provide more study spaces because they are <mark>good for students.</mark>”</p><span class="annotation-line" aria-hidden="true"></span><div class="feedback-comment"><span class="coach-symbol" aria-hidden="true">✳</span><div><b data-sales="fb.comment.title">{sales('fb.comment.title')}</b><p data-sales="fb.comment.text">{sales('fb.comment.text')}</p></div></div><div class="revision"><span data-sales="fb.draft">{sales('fb.draft')}</span><p lang="en">“Quiet study spaces help students use gaps between classes for focused revision.”</p></div><span class="sample-label" data-sales="fb.sample">{sales('fb.sample')}</span></div>
      </div>
      <div class="feedback-copy" data-sc-in>
        <p class="section-note" data-sales="fb.note">{sales('fb.note')}</p>
        <h2 data-sc-copy data-sales="fb.title" set:html={sales('fb.title')} />
        <p data-sales="fb.lead">{sales('fb.lead')}</p>
        <ul class="feedback-list">
          <li><div><b data-sales="fb.1.title">{sales('fb.1.title')}</b><p data-sales="fb.1.text">{sales('fb.1.text')}</p></div></li>
          <li><div><b data-sales="fb.2.title">{sales('fb.2.title')}</b><p data-sales="fb.2.text">{sales('fb.2.text')}</p></div></li>
          <li><div><b data-sales="fb.3.title">{sales('fb.3.title')}</b><p data-sales="fb.3.text">{sales('fb.3.text')}</p></div></li>
        </ul>

        <p class="score-note" data-sales="fb.score">{sales('fb.score')}</p>
      </div>
    </div>
    <div class="content-wrap ai-proof">
      <details class="criteria-explainer">
        <summary><span><b data-sales="fb.criteria.title">{sales('fb.criteria.title')}</b><small data-sales="fb.criteria.text">{sales('fb.criteria.text')}</small></span><span class="criteria-plus" aria-hidden="true">+</span></summary>
        <div class="criteria-body">
          {/* Official criterion names stay English (docs/I18N-GUIDE.md): the
              student meets these exact words in the band descriptors. */}
          <div><h3>Writing</h3><ul lang="en"><li>Task Achievement (Task 1) or Task Response (Task 2)</li><li>Coherence and Cohesion</li><li>Lexical Resource</li><li>Grammatical Range and Accuracy</li></ul></div>
          <div><h3>Speaking</h3><ul lang="en"><li>Fluency and Coherence</li><li>Lexical Resource</li><li>Grammatical Range and Accuracy</li><li>Pronunciation</li></ul></div>
          <p data-sales="fb.criteria.foot">{sales('fb.criteria.foot')}</p>
        </div>
      </details>
    </div>

  </section>

  <PricingPlans />

  <section class="questions section-pad" id="questions" data-sc-act="flow"><div class="content-wrap questions-grid"><div><p class="section-note" data-sales="faq.note">{sales('faq.note')}</p><h2 data-sc-copy data-sales="faq.title" set:html={sales('faq.title')} /></div><div class="faq-list">{faqs.map((id) => <details><summary><span class="faq-q" data-sales={k(`faq.${id}.q`)}>{sales(k(`faq.${id}.q`))}</span><span aria-hidden="true">+</span></summary><p data-sales={k(`faq.${id}.a`)}>{sales(k(`faq.${id}.a`))}</p></details>)}</div></div></section>

  <section class="next-chapter-close" aria-labelledby="close-title" data-sc-act="flow">
    <img src={asset('university-campus.jpg')} width="1536" height="1024" loading="lazy" alt="" />
    <div class="close-card"><p class="section-note" data-sales="close.note">{sales('close.note')}</p><h2 data-sc-copy id="close-title" data-sales="close.title" set:html={sales('close.title')} /><p data-sales="close.lead" set:html={sales('close.lead')} /><a class="button" href={signUp} data-signup-link data-sales="nav.signUp">{sales('nav.signUp')}</a><a class="close-secondary" href={signIn} data-sales="close.signIn">{sales('close.signIn')}</a></div>
  </section>
</main>
<footer class="story-footer"><div class="footer-top content-wrap"><a class="wordmark" href="#main" aria-label={sales('nav.home')} data-sales-attr="aria-label:nav.home">IELTS<span>is</span><b>EZ</b></a><p data-sales="foot.tagline" set:html={sales('foot.tagline')} /><nav aria-label={sales('foot.nav')} data-sales-attr="aria-label:foot.nav"><a href="#your-classroom" data-sales="foot.teach">{sales('foot.teach')}</a><a href="#meet-mr-ez" data-sales="foot.ez">{sales('foot.ez')}</a><a href="#pricing" data-sales="nav.pricing">{sales('nav.pricing')}</a><a href="#questions" data-sales="foot.questions">{sales('foot.questions')}</a><a href={withBase('/privacy')} data-sales="foot.privacy">{sales('foot.privacy')}</a><a href={withBase('/terms')} data-sales="foot.terms">{sales('foot.terms')}</a><a href={withBase('/support?reason=footer')} data-sales="foot.support">{sales('foot.support')}</a></nav></div><div class="footer-bottom content-wrap"><span>© {new Date().getFullYear()} IELTS is EZ</span><span data-sales="foot.independent">{sales('foot.independent')}</span><a href="#main" data-sales="foot.top">{sales('foot.top')}</a></div></footer>
<script>import '../../scripts/next-chapter';</script>
