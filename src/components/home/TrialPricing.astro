---
import { withBase } from '../../lib/url';
import { sales } from '../../marketing/sales-copy';
import { PURCHASE_ENABLED } from '../access/payments';
/* Prices come from the one approved source (also used by /plans), through
   src/marketing/sales-copy.ts, which formats them for each language. Payment
   is only possible where the build has a payments Worker (PURCHASE_ENABLED):
   there each plan's button leads to /plans, where the student signs in and
   buys; everywhere else the buttons stay unavailable and the page says so.
   The trial button opens the real trial page. */
---
<section class="trial-pricing section-pad" id="pricing" aria-labelledby="pricing-title">
 <div class="content-wrap">
  <div class="pricing-heading"><h2 id="pricing-title" data-sales="price.title" set:html={sales('price.title')} /><p data-sales="price.lead" set:html={sales('price.lead')} /></div>
  <div class="pricing-layout">
   <div class="trial-includes"><h3 data-sales="price.includes.title">{sales('price.includes.title')}</h3><p data-sales="price.includes.lead">{sales('price.includes.lead')}</p><p class="section-note includes-label" data-sales="price.includes.full">{sales('price.includes.full')}</p><ul><li data-sales="price.includes.1">{sales('price.includes.1')}</li><li data-sales="price.includes.2">{sales('price.includes.2')}</li><li data-sales="price.includes.3">{sales('price.includes.3')}</li><li data-sales="price.includes.4">{sales('price.includes.4')}</li><li data-sales="price.includes.5">{sales('price.includes.5')}</li></ul><small data-sales="price.includes.small">{sales('price.includes.small')}</small><a class="button" href={withBase('/trial')} data-trial-link data-sales="nav.trial">{sales('nav.trial')}</a></div>
   <div class="price-options" aria-label={sales('price.options')} data-sales-attr="aria-label:price.options">
    <article class="price-option"><div><h3 data-sales="price.one.title">{sales('price.one.title')}</h3><p data-sales="price.one.text">{sales('price.one.text')}</p></div><p class="price-amount" data-sales="price.one.amount" set:html={sales('price.one.amount')} />{PURCHASE_ENABLED ? <a class="price-choose" href={withBase('/plans')} data-sales="price.one.cta">{sales('price.one.cta')}</a> : <button type="button" disabled aria-describedby="checkout-status" data-sales="price.one.cta">{sales('price.one.cta')}</button>}</article>
    <article class="price-option price-option-long"><div><h3 data-sales="price.three.title">{sales('price.three.title')}</h3><p data-sales="price.three.text">{sales('price.three.text')}</p></div><p class="price-amount" data-sales="price.three.amount" set:html={sales('price.three.amount')} /><p class="price-saving" data-sales="price.three.saving">{sales('price.three.saving')}</p>{PURCHASE_ENABLED ? <a class="price-choose" href={withBase('/plans')} data-sales="price.three.cta">{sales('price.three.cta')}</a> : <button type="button" disabled aria-describedby="checkout-status" data-sales="price.three.cta">{sales('price.three.cta')}</button>}</article>
   </div>
  </div>
  <p class="checkout-status" id="checkout-status">{PURCHASE_ENABLED ? <span data-sales="price.status.open">{sales('price.status.open')}</span> : <span data-sales="price.status">{sales('price.status')}</span>} <a href={withBase('/plans')} data-sales="price.plans">{sales('price.plans')}</a></p>
 </div>
</section>
