---
import { withBase } from '../lib/url';
import AccountMenu from './AccountMenu';

const current = Astro.url.pathname;
const isActive = (href: string) => {
  const target = withBase(href);
  if (href === '/') return current === target || current === `${target}/`;
  return current === target || current.startsWith(`${target}/`);
};
const links = [
  { href: '/learn', label: 'Learn', fallbacks: ['/lessons', '/start'] },
  { href: '/trainers', label: 'Practice', fallbacks: ['/trainers', '/writing'] },
  { href: '/tests', label: 'Tests', fallbacks: ['/tests'] },
  { href: '/speaking/examiner', label: 'AI Tutor', fallbacks: ['/speaking'] },
];
const linkActive = (link: (typeof links)[number]) => isActive(link.href) || link.fallbacks.some(isActive);
---

<header class="site-header">
  <nav class="site-nav" aria-label="Main navigation">
    <a href={withBase('/')} class="site-wordmark" aria-label="IELTS is EZ home"><span>IELTS is</span> <span class="site-wordmark-accent">EZ</span></a>
    <div class="site-nav-links" aria-label="Study areas">
      {links.map((link) => <a href={withBase(link.href)} class:list={['site-nav-link', { 'is-active': linkActive(link) }]} aria-current={linkActive(link) ? 'page' : undefined}>{link.label}</a>)}
    </div>
    <div class="site-nav-actions">
      <a href={withBase('/dashboard')} class="site-workspace-button">My workspace</a>
      <div class="site-account-menu"><AccountMenu client:load /></div>
      <button type="button" id="nav-toggle" class="site-menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-mobile"><span></span><span></span><span></span></button>
    </div>
  </nav>
  <div id="nav-mobile" class="site-mobile-menu" hidden>
    <div class="site-mobile-menu-inner">
      {links.map((link) => <a href={withBase(link.href)} class:list={['site-mobile-link', { 'is-active': linkActive(link) }]} aria-current={linkActive(link) ? 'page' : undefined}>{link.label}</a>)}
      <a href={withBase('/dashboard')} class="site-mobile-workspace">My workspace</a>
      <div class="site-mobile-account"><AccountMenu client:load compact /></div>
    </div>
  </div>
</header>

<script>
  function initSiteNav() {
    const toggle = document.getElementById('nav-toggle');
    const menu = document.getElementById('nav-mobile');
    if (!(toggle instanceof HTMLButtonElement) || !(menu instanceof HTMLElement) || toggle.dataset.ready) return;
    toggle.dataset.ready = 'true';
    const close = () => { menu.hidden = true; toggle.setAttribute('aria-expanded', 'false'); toggle.setAttribute('aria-label', 'Open menu'); };
    toggle.addEventListener('click', () => {
      const opening = menu.hidden;
      menu.hidden = !opening;
      toggle.setAttribute('aria-expanded', String(opening));
      toggle.setAttribute('aria-label', opening ? 'Close menu' : 'Open menu');
      if (opening) menu.querySelector<HTMLElement>('a, button')?.focus();
    });
    menu.addEventListener('click', (event) => { if ((event.target as HTMLElement).closest('a')) close(); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !menu.hidden) { close(); toggle.focus(); } });
  }
  initSiteNav();
  document.addEventListener('astro:page-load', initSiteNav);
</script>
