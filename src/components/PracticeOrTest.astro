---
/**
 * Shared explainer for the Practice/Tests split, used under the intro on
 * both hub pages (/trainers and /tests). One place for the wording so the
 * two hubs can never drift apart on how they describe each other.
 *
 * `current` highlights that hub's card with the brand tint; the other card
 * is a plain link across to it.
 */
import { withBase } from '../lib/url';
import { nt } from '../lib/i18n/translate';

interface Props {
  current: 'practice' | 'tests';
}
const { current } = Astro.props;

const cards = [
  {
    id: 'practice' as const,
    label: nt('Practice'),
    href: '/trainers',
    bullets: [
      nt('Guided practice for one skill, with a coach on screen'),
      nt('Use it while you are still learning the format'),
      nt('Hints, model phrases and feedback on every attempt'),
    ],
  },
  {
    id: 'tests' as const,
    label: nt('Tests'),
    href: '/tests',
    bullets: [
      nt('A full test, exactly like the real exam'),
      nt('Use it when you want to know your band'),
      nt('Timed, no hints, a band estimate and review after'),
    ],
  },
];
---

<details class="mode-help">
  <summary data-i18n>What's the difference between Practice and Tests?</summary>
  <div class="mode-help-content">
    {cards.map((card) => <section><h3 data-i18n>{card.label}</h3><ul>{card.bullets.map((line) => <li data-i18n>{line}</li>)}</ul>{card.id !== current && <a href={withBase(card.href)}><span data-i18n>Go to {card.label}</span> <span aria-hidden="true">↗</span></a>}</section>)}
  </div>
</details>
