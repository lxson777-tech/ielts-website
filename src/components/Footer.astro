---
import { withBase } from '../lib/url';
const year = new Date().getFullYear();
const columns = [
  { title: 'Learn', links: [{ label: 'Study plan', href: '/start' }, { label: 'Lessons', href: '/learn' }, { label: 'Vocabulary', href: '/lessons/vocabulary' }] },
  { title: 'Practice', links: [{ label: 'Skill trainers', href: '/trainers' }, { label: 'Mock tests', href: '/tests' }, { label: 'AI speaking', href: '/speaking/examiner' }] },
];
---
<footer class="marketing-footer">
  <div class="marketing-footer-inner">
    <div class="marketing-footer-brand">
      <a href={withBase('/')} class="site-wordmark" aria-label="IELTS is EZ home"><span>IELTS is</span> <span class="site-wordmark-accent">EZ</span></a>
      <p>Clear IELTS preparation that helps you know what to study next.</p>
    </div>
    {columns.map((column) => <div><p class="marketing-footer-heading">{column.title}</p><ul>{column.links.map((link) => <li><a href={withBase(link.href)}>{link.label}</a></li>)}</ul></div>)}
    <div><p class="marketing-footer-heading">Your space</p><a href={withBase('/dashboard')} class="footer-workspace-link">Open workspace <span aria-hidden="true">↗</span></a></div>
  </div>
  <div class="marketing-footer-base"><span>© {year} IELTS is EZ</span><span>Made for focused learners.</span></div>
</footer>

<style>
  .marketing-footer { border-top: 1px solid var(--color-border); background: #f1efe9; }
  .marketing-footer-inner { width: min(100% - 2rem, 1200px); margin-inline: auto; display: grid; grid-template-columns: minmax(240px, 1.7fr) 1fr 1fr 1fr; gap: 3rem; padding-block: 4.5rem 3.5rem; }
  .marketing-footer-brand p { max-width: 33ch; margin-top: 1rem; color: var(--color-ink-muted); font-size: .9rem; }
  .marketing-footer-heading { margin-bottom: 1rem; font-family: var(--font-display); font-size: .76rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  ul { display: grid; gap: .65rem; margin: 0; padding: 0; list-style: none; }
  li a, .footer-workspace-link { color: var(--color-ink-muted); font-size: .87rem; font-weight: 550; text-decoration: none; transition: color 160ms ease; }
  li a:hover, .footer-workspace-link:hover { color: var(--color-brand-hover); }
  .marketing-footer-base { width: min(100% - 2rem, 1200px); margin-inline: auto; display: flex; justify-content: space-between; gap: 1rem; padding-block: 1.25rem; border-top: 1px solid var(--color-border); color: var(--color-ink-muted); font-size: .73rem; }
  @media (max-width: 760px) { .marketing-footer-inner { grid-template-columns: 1fr 1fr; gap: 2.5rem 1.5rem; padding-block: 3rem; } .marketing-footer-brand { grid-column: 1 / -1; } }
</style>
