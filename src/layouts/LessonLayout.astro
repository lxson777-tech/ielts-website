---
import BaseLayout from './BaseLayout.astro';
import Badge from '../components/Badge.astro';
import { withBase } from '../lib/url';
import { getLesson, SKILLS } from '../data/lessons';
import { WORDS } from '../data/words';
import { READING_PARTS } from '../data/reading';
import { LISTENING_PARTS } from '../data/listening';
import { WRITING_PARTS } from '../data/writing';
import { SPEAKING_PARTS } from '../data/speaking';
import { VOCABULARY_PARTS } from '../data/vocabulary';

interface Props {
  slug: string;
  /** For pages not in the LESSONS registry (e.g. reading question-type
      pages): supply the metadata directly. */
  meta?: { title: string; description: string; skill: import('../data/lessons').Skill };
  /** Extra breadcrumb level between Home and this page. */
  parent?: { label: string; href: string };
}

const { slug, meta, parent } = Astro.props;
const lesson = meta ? { ...meta, slug, image: '' } : getLesson(slug);
if (!lesson) throw new Error(`Unknown lesson slug: ${slug}`);
const skill = SKILLS.find((s) => s.id === lesson.skill)!;

/* Part-lesson pages (e.g. /lessons/reading/tfng) pass `meta` rather than a
   LESSONS entry, so they carry no `minutes` of their own — resolve it here
   instead by matching `slug` (e.g. "reading-tfng") back to its part in the
   matching registry. Overview pages skip this and use lesson.minutes
   directly, already sourced from LESSONS in data/lessons.ts. */
const PART_REGISTRIES: { base: string; parts: { slug: string; minutes?: number }[] }[] = [
  { base: 'reading', parts: READING_PARTS },
  { base: 'listening', parts: LISTENING_PARTS },
  { base: 'writing', parts: WRITING_PARTS },
  { base: 'speaking', parts: SPEAKING_PARTS },
  { base: 'vocabulary', parts: VOCABULARY_PARTS },
];
function lookupPartMinutes(lessonSlug: string): number | undefined {
  for (const { base, parts } of PART_REGISTRIES) {
    if (!lessonSlug.startsWith(`${base}-`)) continue;
    const part = parts.find((p) => p.slug === lessonSlug.slice(base.length + 1));
    if (part) return part.minutes;
  }
  return undefined;
}
const minutes = meta ? lookupPartMinutes(slug) : (lesson as { minutes?: number }).minutes;
---

<BaseLayout title={`${lesson.title} · IELTS Portal`} description={lesson.description} lessonKey={slug}>
  <div class={`skill-${lesson.skill}`}>
    <!-- Lesson hero band -->
    <section class="lesson-hero border-b border-border">
      <div class="lesson-hero-content mx-auto max-w-4xl px-4 py-12 sm:px-6">
        <nav class="mb-4 flex items-center gap-1.5 text-sm text-ink-muted" aria-label="Breadcrumb" data-i18n-attr="aria-label">
          {/* py-2/-my-2 pad the tap target to 24px+ without growing the row visually */}
          <a href={withBase('/')} class="inline-block py-2 -my-2 hover:text-ink" data-i18n>Home</a>
          <span aria-hidden="true">/</span>
          {
            parent && (
              <>
                <a href={parent.href} class="inline-block py-2 -my-2 hover:text-ink" data-i18n>{parent.label}</a>
                <span aria-hidden="true">/</span>
              </>
            )
          }
          <span class="font-medium text-ink" data-i18n>{lesson.title}</span>
        </nav>
        <div class="flex items-center gap-2.5">
          <Badge tone="skill"><span data-i18n>{skill.label}</span></Badge>
          {typeof minutes === 'number' && (
            <span class="text-xs font-semibold text-ink-muted">{minutes} <span data-i18n>min</span></span>
          )}
        </div>
        <h1 class="mt-3 max-w-3xl font-display text-4xl font-extrabold tracking-tight sm:text-5xl" data-i18n>{lesson.title}</h1>
        <p class="mt-3 max-w-2xl text-ink-muted" data-i18n>{lesson.description}</p>
      <div class="lesson-word-quiz"><span data-i18n>Vocabulary quick check</span>
        <button
          type="button"
          id="lesson-hero-word-text"
          class="lesson-word-button"
          aria-label="Click to test yourself on this vocabulary word"
          aria-expanded="false"
          aria-controls="lesson-hero-word-panel"
          data-vocab-quiz-trigger
          data-words={JSON.stringify(WORDS.map(({ word, def }) => ({ word, def })))}
          data-i18n-attr="aria-label"
        ></button>
      </div>
        <!-- The floating word drifts and can't host its own panel, so its
             quiz expands here instead, in the static content column. -->
        <div id="lesson-hero-word-panel" class="vocab-quiz-panel mt-4" hidden>
          <p class="vocab-quiz-panel-eyebrow" data-i18n>Quick check</p>
          <h2 class="vocab-quiz-panel-word"></h2>
          <p class="vocab-quiz-panel-prompt" data-i18n>Which definition is correct?</p>
          <div class="vocab-quiz-panel-opts"></div>
        </div>
      </div>
    </section>

    <!-- Migrated lesson content -->
    <article class="lesson-body mx-auto max-w-4xl px-4 py-10 sm:px-6">
      <slot />

      <div class="mt-12 flex flex-col items-center gap-4 border-t border-border pt-8">
        <div class="flex flex-wrap items-center justify-center gap-3">
          {/* "Studied", not "learned": pressing this says the page was
              read, which is all it can say. What the student can actually
              do is measured by the quick check below it and by the
              practice that follows. */}
          <button
            type="button"
            id="lesson-complete-btn"
            data-slug={slug}
            data-minutes={typeof minutes === 'number' ? String(minutes) : undefined}
            class="inline-flex items-center gap-2 rounded-button border border-border bg-surface px-6 py-2.5 font-display text-sm font-semibold transition-colors hover:border-success hover:text-success data-[done]:border-success data-[done]:bg-success-tint data-[done]:text-success"
          >
            <span data-icon>○</span>
            <span data-label data-i18n>Mark this lesson as studied</span>
          </button>
          <button
            type="button"
            id="lesson-save-btn"
            data-slug={slug}
            data-title={lesson.title}
            class="inline-flex items-center gap-2 rounded-button border border-border bg-surface px-6 py-2.5 font-display text-sm font-semibold transition-colors hover:border-brand hover:text-brand data-[saved]:border-brand data-[saved]:bg-brand-tint data-[saved]:text-brand"
          >
            <span data-label data-i18n>Save lesson</span>
          </button>
        </div>

        <nav class="flex flex-wrap items-center justify-center gap-4 text-sm" aria-label="Guided course" data-i18n-attr="aria-label">
          <a href={withBase('/start')} class="font-semibold text-ink-muted hover:text-brand" data-i18n>Back to course</a>
          {/* Filled in by script below from the student's shared session
              (src/lib/learning), not from course position: a lesson opened
              from the library is never given a contradictory next step. */}
          <a id="lesson-next-control" data-course-next href={withBase('/dashboard')} class="rounded-button bg-brand px-5 py-3 font-semibold text-white" hidden>
            <span id="lesson-next-label" data-i18n>Back to today's session</span>
          </a>
        </nav>
        <div class="w-full max-w-xl">
          <div class="flex items-baseline justify-between gap-2">
            <label for="lesson-notes" class="text-xs font-bold uppercase tracking-[0.1em] text-ink-muted" data-i18n>My notes</label>
            <span id="lesson-notes-status" class="text-xs text-ink-muted opacity-0 transition-opacity duration-300" aria-live="polite"></span>
          </div>
          <textarea
            id="lesson-notes"
            data-slug={slug}
            rows="4"
            placeholder="Jot down anything you want to remember about this lesson."
            class="mt-2 w-full resize-y rounded-card border border-border bg-surface p-3 text-sm text-ink outline-none transition-colors focus:border-brand"
            data-i18n-attr="placeholder"
          ></textarea>
        </div>
      </div>
    </article>
  </div>
</BaseLayout>

<style is:global>
  @import '../styles/lesson.css';
</style>

<script>
  import { initReadingQuiz } from '../scripts/lesson-quiz';
  import type { VocabWord } from '../scripts/vocab-quiz';
  import { isLessonComplete, markLessonComplete, onProgressChange, unmarkLessonComplete } from '../lib/progress';
  import { recordLessonStudied } from '../lib/learning/store.browser';
  import { ensureLearningWired, getCurrentSession, markStepDone } from '../lib/learning';
  import { toggleBookmark, isBookmarked, setNote, getNote } from '../lib/notes';
  import { t, onLocaleChange } from '../lib/i18n';
  import { onLessonBodySwap } from '../lib/i18n/lesson-body';
  import { withBase } from '../lib/url';

  ensureLearningWired();

  // Completion ticks on any "<skill> lessons" grid on this page — the
  // per-skill overview (e.g. /lessons/writing) and the cross-links inside
  // "start here" method lessons both use .sample-card, and those cards
  // live inside the lesson body itself, so a language swap recreates
  // them. Resolve via the anchor's fully-qualified pathname (not the raw
  // href) so it works whether the link is written as "writing/charts"
  // (from the overview, one directory up) or just "charts" (from a
  // sibling lesson page, same directory) — both resolve to the same last
  // two path segments.
  function markCompletedLessonCards() {
    document.querySelectorAll<HTMLAnchorElement>('.sample-card[href]').forEach((card) => {
      if (card.querySelector('.sample-status')) return; // already marked
      const segments = card.pathname.split('/').filter(Boolean);
      const lessonSlug = segments.slice(-2).join('-');
      if (!isLessonComplete(lessonSlug)) return;
      const status = document.createElement('span');
      status.className = 'sample-status';
      status.title = t('Completed');
      status.textContent = '✓';
      card.prepend(status);
    });
  }

  // Reading a lesson in Russian replaces the whole lesson body, taking the
  // quiz's click handlers and the completion ticks with it. Both helpers
  // are guarded against running twice on the same node, and the
  // subscription replays, so this is correct whichever order the swap and
  // astro:page-load happen to land in.
  // Which lesson this page is. The completion button carries it, and it
  // is the only thing on the page that does: an Astro <script> is
  // compiled on its own and cannot read the frontmatter above.
  function lessonSlug(): string | undefined {
    return document.getElementById('lesson-complete-btn')?.dataset.slug;
  }

  // The shared "next" control: if this lesson is a step of today's session
  // (src/lib/learning), continue to the session's next step, marking this
  // one done first when the student has pressed "studied". Otherwise offer
  // "Back to today's session" — never a positional guess through the
  // library, which is what this control used to do and the one thing WP8
  // exists to stop it doing for a student who opened the lesson directly.
  function refreshNextControl() {
    const link = document.getElementById('lesson-next-control') as HTMLAnchorElement | null;
    const label = document.getElementById('lesson-next-label');
    if (!link || !label) return;
    const slug = lessonSlug();
    if (!slug) return;

    const backToToday = () => {
      link.href = withBase('/dashboard');
      label.textContent = t("Back to today's session");
      link.hidden = false;
    };

    let session;
    try {
      session = getCurrentSession();
    } catch {
      link.hidden = true;
      return;
    }

    const step = session.steps.find((s) => s.lessonKey === slug);
    if (!step) {
      backToToday();
      return;
    }

    if (isLessonComplete(slug) && step.state !== 'done' && step.state !== 'skipped') {
      try {
        markStepDone(step.stepId);
        session = getCurrentSession();
      } catch {
        // A failed write costs the plan's own bookkeeping, never the tick
        // the student just pressed on the button above.
      }
    }

    const index = session.steps.findIndex((s) => s.stepId === step.stepId);
    const next = session.steps[index + 1];
    if (next && next.href) {
      link.href = withBase(next.href);
      label.textContent = t('Next step: {title}', { title: t(next.objective) });
      link.hidden = false;
      return;
    }
    backToToday();
  }

  onLessonBodySwap(() => {
    initReadingQuiz({ lessonKey: lessonSlug() });
    markCompletedLessonCards();
  });

  // Re-subscribed on every astro:page-load (see below) so a live language
  // switch (no navigation) refreshes this page's JS-set text without
  // leaking a listener per past page: the previous page's subscription is
  // torn down before a new one is created.
  let offLocale: (() => void) | null = null;
  let offNextControlProgress: (() => void) | null = null;

  // Module scripts only execute once, on the initial hard load — they don't
  // re-run after a client-side (astro:transitions) navigation, and this
  // page's own elements (the complete/save buttons, the notes box, the
  // hero word, the quiz) are recreated fresh on every in-site nav. Wiring
  // everything up only inside this listener (not also directly) covers
  // both the first load and every subsequent page swap, since it fires on
  // both (same pattern as VocabQuizInit.astro).
  document.addEventListener('astro:page-load', () => {
    offLocale?.();
    initReadingQuiz({ lessonKey: lessonSlug() });

    // Floating vocabulary word that drifts across the hero panel — one
    // word per lap, swapped to a new random word (never repeating the
    // one just shown) exactly when the CSS drift animation loops, i.e.
    // while the word is off-screen and invisible, so the swap is never
    // visible mid-flight. It's also a [data-vocab-quiz-trigger] pointing
    // (via aria-controls) at #lesson-hero-word-panel above — clicking it
    // expands that inline panel with whatever word is showing at the
    // time. The click wiring itself lives in vocab-quiz.ts (initialized
    // once site-wide by VocabQuizInit.astro), not here.
    const heroWord = document.getElementById('lesson-hero-word-text');
    if (heroWord) {
      const words: VocabWord[] = JSON.parse(heroWord.dataset.words!);
      let last = -1;
      const nextWord = () => {
        let i = Math.floor(Math.random() * words.length);
        if (words.length > 1) while (i === last) i = Math.floor(Math.random() * words.length);
        last = i;
        heroWord.textContent = words[i]!.word;
      };
      nextWord();
      heroWord.addEventListener('animationiteration', (e) => {
        if (e.animationName === 'lesson-hero-word-drift') nextWord();
      });
    }

    const btn = document.getElementById('lesson-complete-btn');
    if (btn) {
      const slug = btn.dataset.slug!;
      const minutes = Number(btn.dataset.minutes);
      const render = (done: boolean) => {
        btn.toggleAttribute('data-done', done);
        btn.querySelector('[data-icon]')!.textContent = done ? '✓' : '○';
        btn.querySelector('[data-label]')!.textContent = done
          ? t('Studied, tap to undo')
          : t('Mark this lesson as studied');
      };
      render(isLessonComplete(slug));
      btn.addEventListener('click', () => {
        const next = !isLessonComplete(slug);
        next ? markLessonComplete(slug) : unmarkLessonComplete(slug);
        // The tick and the history keep working exactly as before, and
        // the same press is now also written to the learner record as
        // `studied`: they opened the page and said they were done with
        // it, which is all a completion click can ever mean. The record
        // is a log of what happened, so unticking removes the tick and
        // leaves the log alone.
        if (next) {
          try {
            recordLessonStudied({
              lessonKey: slug,
              estimatedMinutes: Number.isFinite(minutes) && minutes > 0 ? minutes : undefined,
            });
          } catch {
            /* A blocked or full browser store costs the record, never the
               tick the student just pressed. */
          }
        }
        render(next);
        // Replay the icon pop and the label fade on every press, not just
        // the first: removing the class and reading offsetWidth forces the
        // browser to finish the old animation before the new one starts,
        // which is the only reliable way to restart a CSS animation.
        btn.classList.remove('is-toggling');
        void btn.offsetWidth;
        btn.classList.add('is-toggling');
        refreshNextControl();
      });
    }

    refreshNextControl();
    offNextControlProgress?.();
    // Progress changes on this page only through the studied button above,
    // but the same lesson can also be marked studied from another tab or
    // from a cloud pull, and the control should catch up either way.
    offNextControlProgress = onProgressChange(() => refreshNextControl());

    // Save lesson — a plain bookmark toggle (kind 'lesson'), independent of
    // completion. Stored by notes.ts under the page's own slug/title/href
    // so /account's Saved section can link straight back here.
    const saveBtn = document.getElementById('lesson-save-btn');
    if (saveBtn) {
      const slug = saveBtn.dataset.slug!;
      const title = saveBtn.dataset.title!;
      const href = window.location.pathname;
      const renderSaved = (saved: boolean) => {
        saveBtn.toggleAttribute('data-saved', saved);
        saveBtn.querySelector('[data-label]')!.textContent = saved ? t('Saved, tap to remove') : t('Save lesson');
      };
      renderSaved(isBookmarked('lesson', slug));
      saveBtn.addEventListener('click', () => {
        const saved = toggleBookmark('lesson', slug, { title, href });
        renderSaved(saved);
      });
    }

    // A live language switch (no navigation) needs to refresh this page's
    // own JS-set text: applyTranslations() (see BaseLayout) only reaches
    // elements marked data-i18n, not textContent this script set directly.
    offLocale = onLocaleChange(() => {
      refreshNextControl();
      if (btn) {
        btn.querySelector('[data-label]')!.textContent = btn.hasAttribute('data-done')
          ? t('Studied, tap to undo')
          : t('Mark this lesson as studied');
      }
      if (saveBtn) {
        saveBtn.querySelector('[data-label]')!.textContent = saveBtn.hasAttribute('data-saved')
          ? t('Saved, tap to remove')
          : t('Save lesson');
      }
      document.querySelectorAll<HTMLElement>('.sample-status').forEach((el) => {
        el.title = t('Completed');
      });
    });

    // My notes — a free-text note per lesson, saved on blur and after a
    // short pause in typing, so a note survives even if the student never
    // blurs the field (e.g. they navigate away by clicking a link inside
    // the lesson body itself).
    const notesBox = document.getElementById('lesson-notes') as HTMLTextAreaElement | null;
    const notesStatus = document.getElementById('lesson-notes-status');
    if (notesBox) {
      const slug = notesBox.dataset.slug!;
      notesBox.value = getNote(slug);
      let debounceTimer: ReturnType<typeof setTimeout> | undefined;
      let fadeTimer: ReturnType<typeof setTimeout> | undefined;
      const save = () => {
        setNote(slug, notesBox.value);
        if (notesStatus) {
          notesStatus.textContent = t('Saved', undefined, 'lesson-notes');
          notesStatus.style.opacity = '1';
          clearTimeout(fadeTimer);
          fadeTimer = setTimeout(() => {
            notesStatus.style.opacity = '0';
            setTimeout(() => {
              notesStatus.textContent = '';
            }, 300);
          }, 1500);
        }
      };
      notesBox.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(save, 1000);
      });
      notesBox.addEventListener('blur', () => {
        clearTimeout(debounceTimer);
        save();
      });
    }

    markCompletedLessonCards();
  });
</script>
