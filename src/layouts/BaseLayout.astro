---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/platform.css';
import '../styles/workspace-redesign.css';
import '../styles/mr-ez.css';
import '@fontsource-variable/manrope';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WorkspaceHeader from '../components/WorkspaceHeader.astro';
import WorkspaceFooter from '../components/WorkspaceFooter.astro';
import MrEzPanel from '../components/tutor/MrEzPanel';
import VocabQuizInit from '../components/VocabQuizInit.astro';
import { withBase } from '../lib/url';
import { isAppRoute as routeIsApp, isWideRoute, toRoute } from '../lib/platform-nav';
import { LOCALE_STORAGE_KEY, PENDING_CLASS, SUPPORTED_LOCALES, DEFAULT_LOCALE, RUSSIAN_DEVICE_LANGUAGES } from '../lib/i18n/locale';

interface Props {
  title: string;
  description?: string;
  /** Hide nav/footer chrome (used by the fullscreen test player). */
  bare?: boolean;
  /** Root-relative image path (e.g. '/pics/hero.png'), passed through withBase(). */
  ogImage?: string;
  /** Defaults to 'website'; blog posts should pass 'article'. */
  ogType?: string;
  /** App routes only: use the wider 1100px column instead of 880px, for
      pages whose own content is a split pane or a multi-column grid. */
  wide?: boolean;
  /** A lesson's progress key, when this page IS a lesson. Written onto
      <body> so the Mr EZ panel can tell him which lesson the student is
      looking at without a prop drilled through every island. It is only a
      key: the Worker resolves it against the real course registry and
      ignores anything that does not match, so it carries no authority. */
  lessonKey?: string;
}

const {
  title,
  description = 'Free IELTS preparation: lessons, strategies and timed practice tests for every skill.',
  bare = false,
  ogImage = '/pics/hero.png',
  ogType = 'website',
  wide,
  lessonKey,
} = Astro.props;
const pageTitle = title.replaceAll('IELTS Portal', 'IELTS is EZ');

const absoluteOgImage = new URL(withBase(ogImage), Astro.site).toString();

const route = toRoute(Astro.url.pathname, import.meta.env.BASE_URL);
// The pathname already carries the base and, at build time, a .html suffix;
// the clean route is what the canonical link must point at.
const canonicalUrl = new URL(withBase(route), Astro.site).toString();
const isAppRoute = !bare && routeIsApp(route);
const isWide = wide ?? isWideRoute(route);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: 'IELTS is EZ',
  description: 'Free IELTS preparation: lessons, strategies and timed practice tests for every skill.',
  url: new URL(withBase('/'), Astro.site).toString(),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{pageTitle}</title>

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {/* Language, before first paint.

        The site is static, so every HTML file is built in English. A student
        who chose Russian would otherwise see one frame of English on every
        hard load. This blocking inline script reads the stored choice, puts
        it on <html> (which also fixes the hard-coded lang="en" for screen
        readers), and hides the body until the dictionary has been applied.

        The failsafe matters more than the hiding: the same script schedules
        an unconditional un-hide, so a dictionary chunk that never arrives
        leaves an English page, never a blank one. English students skip all
        of it: no class, no hidden body, no dictionary. */}
    {/* The second rule covers the lesson body specifically. On a hard load
        the whole page is hidden by i18n-pending above, but a client-side
        navigation paints the new page immediately, which would show the
        English lesson for the moment it takes the translated fragment to
        arrive. Hiding just that one block (it keeps its height, so nothing
        jumps) is enough, and it is removed unconditionally after 1500 ms by
        the same failsafe reasoning. */}
    <style is:inline>html.i18n-pending body { visibility: hidden; } [data-lesson-body-loading] { visibility: hidden; }</style>
    {/* define:vars already makes this inline and unprocessed (Astro emits it
        verbatim in the head, which is exactly what "before first paint"
        needs); adding is:inline on top would make the type-checker try to
        resolve the injected names and report them as undefined. */}
    <script
      define:vars={{
        key: LOCALE_STORAGE_KEY,
        locales: [...SUPPORTED_LOCALES],
        fallback: DEFAULT_LOCALE,
        pending: PENDING_CLASS,
        russianDevices: [...RUSSIAN_DEVICE_LANGUAGES],
      }}
    >
      (function () {
        var el = document.documentElement;
        try {
          // A link can choose the language: /lessons/reading/tfng?lang=ru.
          // It is saved exactly as if the student had used the switch, so
          // the rest of the visit stays in that language, and then removed
          // from the address so a copied link does not force it on the next
          // reader. Done here, before first paint, so there is no English
          // flash on a shared Russian link.
          var asked = new URLSearchParams(window.location.search).get('lang');
          if (asked && locales.indexOf(asked) !== -1) {
            window.localStorage.setItem(key, asked);
            var url = new URL(window.location.href);
            url.searchParams.delete('lang');
            window.history.replaceState(window.history.state, '', url.pathname + url.search + url.hash);
          }
          var stored = window.localStorage.getItem(key);
          var locale = stored;
          if (locales.indexOf(stored) === -1) {
            // Nothing chosen yet: a device set to Russian opens in Russian.
            // Same rule as detectLocale() in src/lib/i18n/locale.ts, from the
            // same list, and like it this guess is never saved.
            var first = ((navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase().split('-')[0];
            locale = russianDevices.indexOf(first) === -1 ? fallback : 'ru';
          }
          el.lang = locale;
          el.setAttribute('data-locale', locale);
          if (locale !== fallback) {
            el.classList.add(pending);
            window.setTimeout(function () {
              el.classList.remove(pending);
            }, 1500);
          }
        } catch (e) {
          el.classList.remove(pending);
        }
      })();
    </script>

    <ClientRouter />
  </head>
  <body
    class:list={["flex min-h-screen flex-col bg-surface text-ink", { "workspace-v2": isAppRoute }]}
    data-route={route}
    data-lesson-key={lessonKey}
  >
    {isAppRoute ? (
      <>
        <WorkspaceHeader />
        <a class="ws-skip" href="#workspace-content" data-i18n>Skip to content</a>
        <main class="ws-main" id="workspace-content">
          <div class:list={['ws-page', { 'is-wide': isWide }]}><slot /></div>
          <WorkspaceFooter />
        </main>
        {/* transition:persist keeps the same island, and therefore the same
            open conversation, across a client-side navigation. Mounted only
            on app routes: the fullscreen test player and the mock exam use
            the `bare` layout, so Mr EZ is simply not present during a timed
            paper rather than relying on him declining to help. */}
        <MrEzPanel client:load transition:persist="mr-ez" />
      </>
    ) : (
      <>
        {!bare && <Nav />}
        <main class="flex-1" transition:animate="fade"><slot /></main>
        {!bare && <Footer />}
      </>
    )}
    {!bare && <VocabQuizInit />}
    <script>
      /* The runtime half of the language switch: fetch the dictionary for the
         chosen language, translate everything Astro rendered in English, and
         un-hide the page.

         It re-runs on every navigation and on every locale change, because
         the header, the phone tab bar and the Mr EZ panel carry
         transition:persist — those DOM nodes survive a client-side
         navigation, so nothing re-renders them on their own. applyTranslations
         remembers each element's English original, so re-running is both
         idempotent and exactly reversible. */
      import { getLocale, onLocaleChange, applyDocumentLocale, PENDING_CLASS } from '../lib/i18n/locale';
      import { loadDictionary } from '../lib/i18n/dict/index';
      import { applyTranslations } from '../lib/i18n/dom';
      import { applyLessonBody } from '../lib/i18n/lesson-body';

      async function refreshTranslations() {
        const locale = getLocale();
        applyDocumentLocale(locale);
        // Awaited, so the page is only revealed once the real text is in.
        // loadDictionary never rejects: a failed chunk leaves English.
        if (locale !== 'en') await loadDictionary(locale);
        // The interface strings come from the dictionary; a lesson's
        // teaching content is a whole HTML file, fetched and swapped by
        // lesson-body.ts. Also awaited, and also unable to reject: a lesson
        // with no translation yet simply stays English. On a page that is
        // not a lesson it returns immediately, and for English it does
        // nothing but restore the original if we had swapped it.
        await applyLessonBody();
        applyTranslations();
        document.documentElement.classList.remove(PENDING_CLASS);
      }

      void refreshTranslations();
      // after-swap fires before the new page paints (persisted nodes are
      // already in place); page-load fires once islands are hydrated.
      document.addEventListener('astro:after-swap', () => void refreshTranslations());
      document.addEventListener('astro:page-load', () => void refreshTranslations());
      onLocaleChange(() => void refreshTranslations());
    </script>
    <script>
      import { onLessonBodySwap } from '../lib/i18n/lesson-body';

      const REVEAL_SELECTOR = [
        '[data-reveal]',
        '.lesson-body .section',
        '.lesson-body .vocab-table',
        '.lesson-body .exercise-box',
        '.lesson-body .type-example',
        '.lesson-body .cue-card',
        '.lesson-body .criteria-card',
        '.lesson-body .answer-compare',
        '.lesson-body .passage-box',
        '.lesson-body .task-type-card',
        '.lesson-body .cta-card',
      ].join(',');

      function initScrollReveal() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        // Anything nested inside a <details> (worked examples, "show model
        // report", …) starts hidden until the user opens it, so it never
        // has a chance to naturally intersect while closed — and once
        // opened it should just be there, not queue its own separate
        // fade-up on top of the accordion's own open animation.
        const els = Array.from(document.querySelectorAll<HTMLElement>(REVEAL_SELECTOR)).filter(
          (el) => !el.closest('details'),
        );

        els.forEach((el, i) => {
          if (el.classList.contains('reveal-init')) return;
          el.classList.add('reveal-init');
          el.style.setProperty('--reveal-delay', `${(i % 6) * 70}ms`);
        });

        if (reduceMotion || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          // threshold 0 (any visible pixel), not a ratio: tall sections on
          // narrow phone screens may never have 12% on screen at once, and a
          // fast fling can skip past a ratio threshold entirely, leaving
          // content permanently invisible.
          { threshold: 0, rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => {
          if (!el.classList.contains('is-visible')) io.observe(el);
        });
      }

      // Safety net for the observer above: fast flings can skip an element
      // between rendered frames, anchor jumps teleport past whole sections,
      // and island hydration can swap a node out from under the observer,
      // all of which leave content permanently invisible. On scroll,
      // force-reveal anything the user has already reached or passed,
      // querying the live DOM so replaced nodes are covered too.
      let sweepQueued = false;
      function revealReached() {
        sweepQueued = false;
        for (const el of document.querySelectorAll<HTMLElement>('.reveal-init:not(.is-visible)')) {
          if (el.closest('details')) continue;
          if (el.getBoundingClientRect().top < window.innerHeight * 0.95) el.classList.add('is-visible');
        }
      }
      function queueRevealSweep() {
        if (sweepQueued) return;
        sweepQueued = true;
        requestAnimationFrame(revealReached);
      }
      document.addEventListener('scroll', queueRevealSweep, { passive: true, capture: true });

      initScrollReveal();
      // Late sweep: catch nodes hydration replaced inside the initial viewport.
      setTimeout(revealReached, 1500);
      document.addEventListener('astro:page-load', () => {
        initScrollReveal();
        setTimeout(revealReached, 1500);
      });

      // Card entrance stagger ([data-stagger] containers, 40ms/6px) is
      // handled entirely in CSS now (src/styles/motion.css) — nth-child
      // delays on `[data-stagger] > *`, no script involved. It used to live
      // here, mutating each child's class/style on page load and on a
      // MutationObserver tick, but several [data-stagger] containers
      // (LearningDashboard's dash-cards/dash-skills-row, PlanToday's item
      // list, Course's module list) are rendered inside React islands: this
      // script ran before those islands finished hydrating, so React's
      // hydration diff saw class/style attributes on the cards that its own
      // render never produced and logged a hydration mismatch warning.
      // Moving the delay into CSS removes the pre-hydration DOM write
      // entirely — the fix is root-cause, not a timing patch.

      // Animated <details>/<summary> expand-collapse — covers every
      // collapsible in lesson content (worked examples, "show model
      // report", quiz answers, …) so opening one smoothly grows instead
      // of the browser's instant snap. Wraps whatever markup follows
      // <summary> in a single measurable element at runtime so it works
      // regardless of how the migrated content nests its children.
      function initDetailsAnimation() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const allDetails = document.querySelectorAll<HTMLDetailsElement>(
          '.lesson-body details:not([data-animated])',
        );

        allDetails.forEach((details) => {
          details.dataset.animated = 'true';
          const summary = details.querySelector(':scope > summary');
          if (!summary) return;

          if (reduceMotion) return; // native open/close is already instant

          const content = document.createElement('div');
          content.className = 'details-content';
          let node = summary.nextSibling;
          while (node) {
            const next = node.nextSibling;
            content.appendChild(node);
            node = next;
          }
          details.appendChild(content);

          let animation: Animation | null = null;

          summary.addEventListener('click', (e) => {
            e.preventDefault();
            if (details.classList.contains('is-animating')) return;
            details.open ? collapse() : expand();
          });

          function expand() {
            details.classList.add('is-animating', 'is-open');
            details.open = true;
            const endHeight = content.offsetHeight;
            animation?.cancel();
            content.style.height = '0px';
            animation = content.animate(
              [{ height: '0px' }, { height: `${endHeight}px` }],
              { duration: 250, easing: 'cubic-bezier(.16,1,.3,1)' },
            );
            animation.onfinish = () => {
              content.style.height = 'auto';
              details.classList.remove('is-animating');
            };
          }

          function collapse() {
            details.classList.add('is-animating');
            details.classList.remove('is-open');
            const startHeight = content.offsetHeight;
            animation?.cancel();
            animation = content.animate(
              [{ height: `${startHeight}px` }, { height: '0px' }],
              { duration: 200, easing: 'ease' },
            );
            animation.onfinish = () => {
              details.open = false;
              content.style.height = '0px';
              details.classList.remove('is-animating');
            };
          }
        });
      }

      initDetailsAnimation();
      document.addEventListener('astro:page-load', initDetailsAnimation);

      // Reading a lesson in Russian replaces every node inside the lesson
      // body, so the reveal classes and the accordion wrappers those two
      // functions installed are gone with the English markup. Both are
      // guarded against running twice on the same node (.reveal-init and
      // [data-animated]), so this is only ever doing the new nodes.
      //
      // onLessonBodySwap replays: if the swap already happened before this
      // script block executed, the callback fires straight away. That is
      // what keeps the fix independent of the order the bundled module
      // scripts happen to run in.
      onLessonBodySwap(() => {
        initScrollReveal();
        revealReached();
        initDetailsAnimation();
      });
    </script>
  </body>
</html>
