---
import '@fontsource-variable/manrope';
import '@fontsource-variable/inter';
import '../styles/next-chapter.css';
import '../styles/sales-page.css';
import { withBase } from '../lib/url';
import { LOCALE_STORAGE_KEY, PENDING_CLASS, SUPPORTED_LOCALES, DEFAULT_LOCALE, DEVICE_LANGUAGE_LOCALE } from '../lib/i18n/locale';
import { sales } from '../marketing/sales-copy';
/* The English is what crawlers and link previews read; a visitor who chose
   Russian (here or in the workspace) gets the Russian title and description
   from src/marketing/sales-i18n.ts. */
const title = sales('meta.title');
const description = sales('meta.description');
const canonical = new URL(withBase('/'), Astro.site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#152a2e" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(withBase('/pics/next-chapter/university-campus.jpg'), Astro.site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" as="image" href={withBase('/pics/next-chapter/university-campus.jpg')} media="(min-width:1051px)" fetchpriority="high" />
    <link rel="preload" as="image" href={withBase('/pics/next-chapter/university-campus-mobile.jpg')} media="(max-width:1050px)" fetchpriority="high" />
    {/* The same before-first-paint language step as BaseLayout.astro: the
        stored choice (or ?lang=ru, or a Russian-set device) goes on <html>,
        and a Russian page stays hidden for the instant it takes
        sales-i18n.ts to swap the text, so there is no English flash. The
        failsafe un-hides it regardless, so the page is never left blank. */}
    <style is:inline>html.i18n-pending body { visibility: hidden; }</style>
    <script
      define:vars={{
        key: LOCALE_STORAGE_KEY,
        locales: [...SUPPORTED_LOCALES],
        fallback: DEFAULT_LOCALE,
        pending: PENDING_CLASS,
        deviceLocales: { ...DEVICE_LANGUAGE_LOCALE },
      }}
    >
      (function () {
        var el = document.documentElement;
        try {
          var asked = new URLSearchParams(window.location.search).get('lang');
          if (asked && locales.indexOf(asked) !== -1) {
            window.localStorage.setItem(key, asked);
            var url = new URL(window.location.href);
            url.searchParams.delete('lang');
            window.history.replaceState(window.history.state, '', url.pathname + url.search + url.hash);
          }
          var stored = window.localStorage.getItem(key);
          var locale = stored;
          if (locales.indexOf(stored) === -1) {
            var first = ((navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase().split('-')[0];
            locale = Object.prototype.hasOwnProperty.call(deviceLocales, first) ? deviceLocales[first] : fallback;
          }
          el.lang = locale;
          el.setAttribute('data-locale', locale);
          if (locale !== fallback) {
            el.classList.add(pending);
            window.setTimeout(function () {
              el.classList.remove(pending);
            }, 1500);
          }
        } catch (e) {
          el.classList.remove(pending);
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main" data-sales="skip">{sales('skip')}</a>
    <slot />
    <script>import '../marketing/sales-i18n';</script>
  </body>
</html>
