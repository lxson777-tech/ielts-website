---
import '@fontsource-variable/manrope';
import '@fontsource-variable/inter';
import '../styles/next-chapter.css';
import '../styles/sales-page.css';
import { withBase } from '../lib/url';
const title = 'IELTS is EZ | Open the gates to your future';
const description = 'Make your next chapter possible. Clear IELTS lessons, guided practice, realistic tests and useful AI feedback, all in one study space.';
const canonical = new URL(withBase('/'), Astro.site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#152a2e" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(withBase('/pics/next-chapter/university-campus.jpg'), Astro.site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" as="image" href={withBase('/pics/next-chapter/university-campus.jpg')} media="(min-width:1051px)" fetchpriority="high" />
    <link rel="preload" as="image" href={withBase('/pics/next-chapter/university-campus-mobile.jpg')} media="(max-width:1050px)" fetchpriority="high" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
